Cell["\<\
Find the list of non-isomorphic simplicial complexes from the 2 lists \
(without checking for isomorphism within individual lists:\
\>", "ExampleText",
 CellID->9239360,ExpressionUUID->"fcab091f-3a01-410b-adc3-4f4e317866eb"],

Cell[CellGroupData[{

Cell[BoxData[
