Cell["\<\
As pure simplicial complexes, g1 and g2 have the following facets:\
\>", "ExampleText",
 CellID->11810780,ExpressionUUID->"ec4b11f4-1385-4473-a809-53045815d884"],

Cell[CellGroupData[{

Cell["facets1 = {{2,3},{1,2}}", "Input",
 CellLabel->"In[4]:=",
 CellID->179282866,ExpressionUUID->"f297f265-43cb-4f50-95e0-b2e40cf1bc14"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->415106380,ExpressionUUID->"28f4ffbb-09f8-4ed2-9b31-0c7ec757e611"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"facets2", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4"}], "}"}]}], "}"}]}]], "Input",
 CellLabel->"In[5]:=",
 CellID->359497564,ExpressionUUID->"b85c4ff3-f3fe-4167-85d1-b77d7c63cbad"],

Cell[BoxData[
 RowBox[{"{", 
