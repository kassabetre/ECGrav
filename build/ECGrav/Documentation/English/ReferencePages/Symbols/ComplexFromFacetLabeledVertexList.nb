Cell["\<\
Facets can be labeled in any manner. Suppose we label in descending canonical \
order (i.e., by largest cardinality, then smallest number).\
\>", "ExampleText",
 CellID->50079376,ExpressionUUID->"0fb32872-1ce9-42e5-bbb1-691abb520db5"],

Cell["\<\
As a clique complex, facet 1 would be {1,2,3} and facet 2 would be {3,4}.\
\>", "ExampleText",
 CellID->187968968,ExpressionUUID->"b77c0df9-7441-4bf7-bcf8-f5b8e38c793e"],

Cell["\<\
Re-labeling each vertex by the facet it belongs to, gives us:\
\>", "ExampleText",
 CellID->33521124,ExpressionUUID->"b83534c4-d326-41b3-9aec-32eacd1c67f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"vertices", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "1", "}"}], ",", 
    RowBox[{"{", "1", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", "2", "}"}]}], "}"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->108364005,ExpressionUUID->"5cf9651a-6d38-4cba-8553-538d76f28f24"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "2", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->399312775,ExpressionUUID->"6636b6a6-ff7f-4962-b59d-c9b3f45463c8"]
}, Open  ]],

Cell["We now find g as a list of its facets:", "ExampleText",
 CellID->110411988,ExpressionUUID->"6e095c7b-ee1d-4683-9c32-f9500044bc57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ComplexFromFacetLabeledVertexList", "[", "vertices", "]"}]], "Input",\

 CellLabel->"In[3]:=",
 CellID->82933389,ExpressionUUID->"bd63b5f6-8d91-4775-9ef0-5cf8de01f36e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
