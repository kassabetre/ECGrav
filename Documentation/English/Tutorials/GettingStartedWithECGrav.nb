Notebook[{
Cell["Getting Started with ECGrav", "Title",
 CellID->603307334,ExpressionUUID->"ad8c33fa-2dfb-4913-b040-ba072c58b65b"],

Cell["\<\
This tutorial walks through the core ECGrav Monte Carlo workflow: build a \
seed graph, choose a Hamiltonian, run a Metropolis simulation, read the \
measured observables, and plot them. It assumes the paclet is installed.\
\>", "Text",
 CellID->251755892,ExpressionUUID->"7c46b4e0-0262-490b-8556-b914777b000e"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<ECGrav`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->133365873,ExpressionUUID->"da2fe7eb-7972-4821-9384-4a9a3248e1dd"],

Cell[CellGroupData[{

Cell["Build a seed graph", "Section",
 CellID->878075396,ExpressionUUID->"faced577-2349-4bfc-a08e-8505b812fcc9"],

Cell["\<\
Graph states are represented by adjacency matrices. Start from a 10-vertex \
cycle:\
\>", "Text",
 CellID->818404338,ExpressionUUID->"943e6cd3-82c8-4a0b-b310-6f6ae8663329"],

Cell[BoxData[
 RowBox[{"seed", "=", 
  RowBox[{"Normal", "[", 
   RowBox[{"AdjacencyMatrix", "[", 
    RowBox[{"CycleGraph", "[", "10", "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->790172523,ExpressionUUID->"1c411e3e-27e3-4395-bab6-278836a2d9be"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Choose a Hamiltonian", "Section",
 CellID->884499036,ExpressionUUID->"c1ba010e-5252-45ff-96ba-2e87ecbb8433"],

Cell["\<\
The Monte Carlo drivers take the energy as a one-argument function of an \
adjacency matrix. Use the Ising energy with coupling J = -1, which rewards \
adding edges:\
\>", "Text",
 CellID->964476509,ExpressionUUID->"9a4f6bc3-020d-4cb2-a8e7-3f71e7a01623"],

Cell[BoxData[
 RowBox[{"H", "=", 
  RowBox[{
   RowBox[{"HIsing", "[", 
    RowBox[{"#1", ",", 
     RowBox[{"-", "1.`"}], ",", "0.`"}], "]"}], "&"}]}]], "Input",
 CellLabel->"In[3]:=",
 CellID->337365999,ExpressionUUID->"61b38b28-e2ac-4bc4-9beb-06b9274b5a97"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Run a Metropolis simulation", "Section",
 CellID->454700129,ExpressionUUID->"35d4512f-a141-4659-96a1-cd8d962a4913"],

Cell["\<\
Run 50 Metropolis sweeps at inverse temperature \[Beta] = 0.5, measuring the \
average degree at each sweep. GraphMetropolis returns the final graph and a \
table of {sweep, energy, observable} rows:\
\>", "Text",
 CellID->151242869,ExpressionUUID->"3d0092cf-d0b7-4a79-879a-b21e1395113b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"final", ",", "series"}], "}"}], "=", 
  RowBox[{"GraphMetropolis", "[", 
   RowBox[{"seed", ",", "0.5`", ",", "H", ",", 
    RowBox[{"{", "AvgDeg", "}"}], ",", "50"}], "]"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->474492818,ExpressionUUID->"12a788ee-0efc-4b3b-944a-3acde86dfac8"],

Cell["\<\
The measurement table has one row per sweep and three columns:\
\>", "Text",
 CellID->513972726,ExpressionUUID->"4f860387-f736-41f4-bed1-089edc05bf26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dimensions", "[", "series", "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->833347294,ExpressionUUID->"e9d6ec0c-7389-4c38-af71-0ab60eae18c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"50", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->619015642,ExpressionUUID->"b168a70e-3a5b-40e7-b3c2-ff31dc7d3b58"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Read observables and plot", "Section",
 CellID->132337640,ExpressionUUID->"85bfbfd2-521d-4402-a814-7fd81e2c81b8"],

Cell["\<\
Plot how the average degree (the third column) evolves as the simulation \
drives the sparse cycle toward a denser graph. Because the dynamics are \
stochastic, each run gives a somewhat different trajectory:\
\>", "Text",
 CellID->394364076,ExpressionUUID->"b6df9cb7-ce90-4136-a6e2-ed10077a8eca"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"series", "\[LeftDoubleBracket]", 
    RowBox[{"All", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<sweep\>\"", ",", "\"\<average degree\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->194292374,ExpressionUUID->"c5f0b964-8ca3-4f84-a500-331983309883"],

Cell["\<\
From here, GraphEquilibriate, GraphComputeCorrelationTime, and \
GraphMultiHistogram automate equilibration, autocorrelation, and \
multi-temperature reweighting; see the ECGrav guide for the full API.\
\>", "Text",
 CellID->588306161,ExpressionUUID->"fd709835-abb3-43e7-a644-aee59ee6e1e1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Metadata", "MetadataSection",
 CellID->929717436,ExpressionUUID->"0619d567-e594-4e43-be0d-6c6a2c70cc41"],

Cell[CellGroupData[{

Cell["Categorization", "CategorizationSection",
 CellID->863615486,ExpressionUUID->"d62539ec-3e90-4a2c-82c0-e3da046af38c"],

Cell["Tech Note", "Categorization",
 CellLabel->"Entity Type",
 CellID->544300238,ExpressionUUID->"f164fc79-099a-4e23-870b-bd2b610a6a6d"],

Cell["ECGrav", "Categorization",
 CellLabel->"Paclet Name",
 CellID->669531539,ExpressionUUID->"04a834bf-f9b9-495e-9a90-c451a1f6e028"],

Cell["ECGrav`", "Categorization",
 CellLabel->"Context",
 CellID->649541567,ExpressionUUID->"8256f5e3-47ef-42af-8f3a-0584072b675a"],

Cell["ECGrav/tutorial/GettingStartedWithECGrav", "Categorization",
 CellLabel->"URI",
 CellID->921293465,ExpressionUUID->"9659a498-f707-4be0-acbc-89ef449e4288"]
}, Closed]]
}, Open  ]]
},
