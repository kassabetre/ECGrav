Notebook[{

Cell[CellGroupData[{
Cell["GraphSweepReplica", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"778c605f-75dc-4673-825e-7261a2bbba7f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphSweepReplica",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphSweepReplica"], "[", 
   StyleBox[
    RowBox[{"seedGraph_", ",", " ", "beta_", ",", " ", 
     RowBox[{"H_", "[", "params___", "]"}], ",", " ", "NN_", ",", " ", 
     "minEToBeat_", ",", " ", "unlabeled_"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"381092cd-3373-4607-9781-6fdaaa934a90"],
 " performs ",
 Cell[BoxData[
  StyleBox["NN", "TI"]], "InlineFormula",ExpressionUUID->
  "469f4425-1227-49b1-b0c1-990ae8d0f48f"],
 " MCMC sweeps on the seed graph ",
 Cell[BoxData[
  StyleBox["seedGraph", "TI"]], "InlineFormula",ExpressionUUID->
  "dcd5bd91-81f8-498d-a518-dfd6ee7a3d6e"],
 " at inverse temperature ",
 Cell[BoxData[
  StyleBox["beta", "TI"]], "InlineFormula",ExpressionUUID->
  "3610b33f-b25e-445c-b90f-49e588e3f270"],
 ", saving the lowest-energy states below ",
 Cell[BoxData[
  StyleBox["minEToBeat", "TI"]], "InlineFormula",ExpressionUUID->
  "1bad1c20-0964-4002-9dda-75bf4d36323a"],
 ". An overload inserts a delta-energy formula delH[params] after ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",ExpressionUUID->
  "84d04335-181c-4d73-a8e6-b6a5154b7381"],
 "[params]."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The Hamiltonian is passed as an inert head with its parameters, e.g. \
h[-1.,0.] where h[a_,j_,l_]:=HIsing[a,j,l]; the driver then calls \
h[state,-1.,0.]. Returns {minimum-energy association, final-state \
association}. unlabeled = 0 or 1 selects labeled or unlabeled sampling. \
Results are stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

