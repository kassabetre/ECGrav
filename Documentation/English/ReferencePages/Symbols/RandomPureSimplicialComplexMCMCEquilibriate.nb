Notebook[{

Cell[CellGroupData[{
Cell["RandomPureSimplicialComplexMCMCEquilibriate", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b3ebc629-a1fb-44e9-8858-fcf1206fa4fe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomPureSimplicialComplexMCMCEquilibriate",
    BaseStyle->"Link",
    ButtonData->
     "paclet:ECGrav/ref/RandomPureSimplicialComplexMCMCEquilibriate"], "[", 
   StyleBox[
    RowBox[{"seedComplex_List", ",", " ", "labelingChoise_Integer"}], "TI"], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "43d4aaf9-d5f1-4b76-89a1-c9456b2de5f0"],
 " runs enough MCMC sweeps to equilibrate ",
 Cell[BoxData[
  StyleBox["seedComplex", "TI"]], "InlineFormula",ExpressionUUID->
  "f9e3ba29-4b30-425c-bb57-4d1faccd23b0"],
 ", and returns an association with the equilibration time \"eqlT\" and the \
equilibrated \"state\". ",
 Cell[BoxData[
  StyleBox["labelingChoise", "TI"]], "InlineFormula",ExpressionUUID->
  "dc6bcf06-c563-402c-9367-0c81dd39d616"],
 " is 0, 1, or 2 for vertex-labeled, facet-labeled, or unlabeled."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Equilibration is judged by comparing the sampled probabilities of several \
reference complexes (the input, and the minimum-, maximum-vertex, and a \
random complex). The run prints live progress and a diagnostic plot.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

