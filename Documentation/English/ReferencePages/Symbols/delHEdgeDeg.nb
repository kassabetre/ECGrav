Notebook[{

Cell[CellGroupData[{
Cell["delHEdgeDeg", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"33f7379e-a9d8-476a-9d15-739d3d8c645c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["delHEdgeDeg",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/delHEdgeDeg"], "[", 
   StyleBox[
    RowBox[{
    "Am_List", ",", " ", "J_", ",", " ", "D1_", ",", " ", "D2_", ",", " ", 
     "a_Integer", ",", " ", "b_Integer"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"6a10c897-1d10-446f-be23-608867dcc223"],
 " gives the change in ",
 Cell[BoxData[
  StyleBox["HEdgeDeg", "TI"]], "InlineFormula",ExpressionUUID->
  "432409d9-c02a-4400-8999-de82c15b696a"],
 " when ",
 Cell[BoxData[
  StyleBox["Am", "TI"]], "InlineFormula",ExpressionUUID->
  "bea1a674-3cc3-4c4e-877b-68345811f617"],
 " is toggled at row ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "4069da6c-f594-415f-921b-25cae4c184cb"],
 " and column ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "38ce7291-547b-4705-adb7-dc2cd36ca89f"],
 ". An overload takes the precomputed square ",
 Cell[BoxData[
  StyleBox["Amsq", "TI"]], "InlineFormula",ExpressionUUID->
  "bbb0912c-646e-4d96-b58e-312e743c8acf"],
 " = Am.Am before ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "1baf5970-d59b-474e-867a-1ec36663e6f0"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
As with delHIsing, this incremental form is what the Metropolis sampler uses \
per proposed edge flip. Passing Amsq = Am.Am avoids recomputing the square \
each step.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

