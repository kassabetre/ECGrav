Cell["\<\
Toggling the edge between vertices 1 and 2 of K4 changes the edge-degree \
energy by -2.25:\
\>", "ExampleText",
 CellID->392862564,ExpressionUUID->"2722194b-81c1-4270-840e-41fc92d3a40f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"delHEdgeDeg", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"AdjacencyMatrix", "[", 
     RowBox[{"CompleteGraph", "[", "4", "]"}], "]"}], "]"}], ",", "1.`", ",", 
   "1.`", ",", "0.`", ",", "1", ",", "2"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->222675957,ExpressionUUID->"3f57f975-2628-4034-92e5-e81f56f1882f"],

Cell[BoxData[
 RowBox[{"-", "2.25`"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->567875622,ExpressionUUID->"7366da6e-9dc9-4110-9704-667da85cfdf3"]
}, Open  ]]
}, Open  ]],

