Cell[CellGroupData[{
Cell["SimulatedAnnealing", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"66d0f1a4-12e9-49a1-bd8e-75e252770ec0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimulatedAnnealing",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/SimulatedAnnealing"], "[", 
   StyleBox[
    RowBox[{"seedAmat_", ",", " ", 
     RowBox[{"H_", "[", "params___", "]"}], ",", " ", "delH_", ",", " ", 
     "betai_", ",", " ", "betaf_", ",", " ", "roundLength_", ",", " ", 
     "NN_"}], "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "44a13e26-8a11-44c1-9040-5aeff2a2dc38"],
 " runs simulated-annealing ground-state search from the seed adjacency \
matrix ",
 Cell[BoxData[
  StyleBox["seedAmat", "TI"]], "InlineFormula",ExpressionUUID->
  "4c01f05a-11bd-4d76-a414-01ad1a6f5555"],
 ", cooling from inverse temperature ",
 Cell[BoxData[
  StyleBox["betai", "TI"]], "InlineFormula",ExpressionUUID->
  "5d5e633f-89e2-4265-b9c4-54a18db3a61a"],
 " to ",
 Cell[BoxData[
  StyleBox["betaf", "TI"]], "InlineFormula",ExpressionUUID->
  "071dbea6-1688-4f74-b193-c5e7117dd785"],
 " over ",
 Cell[BoxData[
  StyleBox["NN", "TI"]], "InlineFormula",ExpressionUUID->
  "c1435326-b651-4342-88af-69c6d82d3050"],
 " sweeps."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The Hamiltonian is an inert head with parameters (e.g. h[-1.,0.]) and delH a \
three-argument pure function (e.g. delHIsing[#1,-1.,0.,#2,#3]&). roundLength \
sets how long to dwell at each temperature. Returns an association {minE, \
excitedEnergy, minEstates, excitedStates, LastState}. Results are stochastic.\
\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

