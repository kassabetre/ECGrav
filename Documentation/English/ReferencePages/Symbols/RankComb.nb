Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3a05899d-4dc9-1546-8bc3-375bbe7ea8ae"],
 " ",
 Cell[BoxData[
  ButtonBox["RankComb",
   BaseStyle->"Link",
   ButtonData->"paclet:ECGrav/ref/RankComb"]], "InlineFormula",ExpressionUUID->
  "56e936f8-7bfa-e142-83d2-afaec1cc9294"],
 "[",
 Cell[BoxData[
  StyleBox["set_List", "TI"]], "InlineFormula",ExpressionUUID->
  "f4147260-7062-474c-9134-46ddf8d1c45e"],
 ",",
 Cell[BoxData[
  StyleBox["numLabels_Integer", "TI"]], "InlineFormula",ExpressionUUID->
  "d34c5e6c-e6e8-9c4d-90c1-1232c9f51205"],
 "]: \[IndentingNewLine]Given a sorted set which is a length(",
 Cell[BoxData[
  StyleBox["set", "TI"]], "InlineFormula",ExpressionUUID->
  "58b247e8-9ca3-f949-8b6d-851de09682e0"],
 ")-subset of the set {0,1,...,",
 Cell[BoxData[
  StyleBox["numLabels", "TI"]], "InlineFormula",ExpressionUUID->
  "4eb09858-ac58-6746-941a-9899df8c9605"],
 "-1}, it assigns a unique integer to ",
 Cell[BoxData[
  StyleBox["set", "TI"]], "InlineFormula",ExpressionUUID->
  "444b9dba-07fc-1648-8990-76b0652fc6b0"],
 " between 0 and ",
 Cell[BoxData[
  StyleBox["numLabels", "TI"]], "InlineFormula",ExpressionUUID->
  "6dc03512-fa31-4444-b261-b11e885a825d"],
 " choose length(",
 Cell[BoxData[
  StyleBox["set", "TI"]], "InlineFormula",ExpressionUUID->
  "d92969ea-4b18-9e49-b231-343f801413f9"],
 ")-1.\[IndentingNewLine]E.g., RankComb[{0,1},3] = 0, and RankComb[{1,2},3]=3."
}], "Usage",
 CellChangeTimes->{{3.970792740321209*^9, 3.9707927986848392`*^9}, {
