Notebook[{

Cell[CellGroupData[{
Cell["HEdgeDeg", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2b928d7e-11fe-44ef-b635-7a1995481f07"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HEdgeDeg",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/HEdgeDeg"], "[", 
   StyleBox[
    RowBox[{"Am_List", ",", " ", "J_", ",", " ", "D1_", ",", " ", "D2_"}], 
    "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e1830425-5a2d-4f29-aee7-00b30dbcd4ab"],
 " gives the edge-degree Hamiltonian ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",ExpressionUUID->
  "ec4c52e9-1d20-4025-92d9-f63e58e853d1"],
 "/(2N)\[Times](Tr(A\.b4 - A(2",
 Cell[BoxData[
  StyleBox["D1", "TI"]], "InlineFormula",ExpressionUUID->
  "c5e62ad8-3c08-4a14-b0c0-a706e5d586bc"],
 "K + 2",
 Cell[BoxData[
  StyleBox["D2", "TI"]], "InlineFormula",ExpressionUUID->
  "b97a0cff-f776-4f8c-a14f-eb06430236d2"],
 "I)A) + ",
 Cell[BoxData[
  StyleBox["D1", "TI"]], "InlineFormula",ExpressionUUID->
  "06cf1968-b05d-47eb-9187-d990b25b5c58"],
 "\.b2 n(n-1)) of the graph with adjacency matrix ",
 Cell[BoxData[
  StyleBox["Am", "TI"]], "InlineFormula",ExpressionUUID->
  "8e469079-7713-42aa-ab65-a49dc5385097"],
 ", where K is the complete-graph adjacency matrix."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The couplings J, D1, D2 must be real. delHEdgeDeg gives the change in \
HEdgeDeg under a single edge toggle.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

