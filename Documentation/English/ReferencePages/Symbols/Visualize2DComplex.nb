Cell[CellGroupData[{
Cell["Visualize2DComplex", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b7541478-a7b0-4318-8bdb-9ec9d1d26fd8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Visualize2DComplex",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/Visualize2DComplex"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c0ffda11-94ec-45e8-b8d2-68a39f65fca7"],
 " gives a 3D rendering of the 2-dimensional pure complex ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "a88748e8-5598-4027-95a0-879d0988463a"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The complex must be pure of dimension 2 (every facet is a triangle). The \
result is a Graphics3D object.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

