Cell["Draw 100 samples from the unlabeled ensemble, starting from the boundary of a tetrahedron and tracking the vertex count, then read off the effective sample size. This runs the full pipeline and prints diagnostic plots:", "ExampleText",
 CellID->990062307,ExpressionUUID->"f38ed9d1-a410-4947-bccc-59ddc79c39d1"],

Cell[BoxData[{
 RowBox[{RowBox[{RowBox[{"{", RowBox[{"measurements", ",", "info"}], "}"}], "=", RowBox[{"RandomPureSimplicialComplexMCMC", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", "3", ",", "4"}], "}"}], ",", RowBox[{"{", RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"Length", "[", RowBox[{"Union", "[", RowBox[{"Flatten", "[", "#1", "]"}], "]"}], "]"}], "&"}], "}"}], ",", "2", ",", "100"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"info", "[", "\"\<effectiveSampleSize\>\"", "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->871494111,ExpressionUUID->"67f325c9-8c2a-485b-a4d0-97c720bc315f"]
}, Open  ]],

