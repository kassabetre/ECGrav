Cell["\<\
Draw independent samples from the uniform distribution over pure complexes, \
tracking a vertex-count observable (this runs the full pipeline and prints \
diagnostics):\
\>", "ExampleText",
 CellID->990062307,ExpressionUUID->"f38ed9d1-a410-4947-bccc-59ddc79c39d1"],

Cell[BoxData[
 RowBox[{"RandomPureSimplicialComplexMCMC", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"Union", "[", 
       RowBox[{"Flatten", "[", "#1", "]"}], "]"}], "]"}], "&"}], "}"}], ",", 
   "2", ",", "100"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->871494111,ExpressionUUID->"67f325c9-8c2a-485b-a4d0-97c720bc315f"]
}, Open  ]],

