Notebook[{

Cell[CellGroupData[{
Cell["RandomPureSimplicialComplexMCMC", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"00e96c4b-1fe2-4754-88dd-2c8beb04ced7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomPureSimplicialComplexMCMC",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/RandomPureSimplicialComplexMCMC"], "[", 
   StyleBox[
    RowBox[{
    "seedComplex_List", ",", " ", "operators_", ",", " ", 
     "labelingChoise_Integer", ",", " ", "numSamples_Integer"}], "TI"], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "12710162-7290-4255-ada3-ea4c5403782d"],
 " returns ",
 Cell[BoxData[
  StyleBox["numSamples", "TI"]], "InlineFormula",ExpressionUUID->
  "c01a2b29-de53-4c85-840b-9a336176ddac"],
 " independent pure simplicial complexes drawn from the uniform distribution. \
It first equilibrates ",
 Cell[BoxData[
  StyleBox["seedComplex", "TI"]], "InlineFormula",ExpressionUUID->
  "784f388f-485d-45de-88ca-b76b7d6e47a3"],
 " and estimates correlation times, tracking the observables ",
 Cell[BoxData[
  StyleBox["operators", "TI"]], "InlineFormula",ExpressionUUID->
  "512c6083-9206-471c-a956-ce1788c6c96b"],
 " (a non-empty list of pure functions). ",
 Cell[BoxData[
  StyleBox["labelingChoise", "TI"]], "InlineFormula",ExpressionUUID->
  "b37a709f-ccc4-4707-886c-958af39bb229"],
 " is 0, 1, or 2 for vertex-labeled, facet-labeled, or unlabeled."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The sampler runs equilibration and correlation-time estimation before drawing \
samples, spacing draws by the measured correlation time, and prints \
diagnostic plots. A prior-run association may be supplied in place of \
seedComplex to continue sampling. operators must match {__Function}.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

