Notebook[{

Cell[CellGroupData[{
Cell["RandomPureSimplicialComplexMCMC", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23fcd72e-0251-49d9-a8a9-8cb743075c75"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomPureSimplicialComplexMCMC",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/RandomPureSimplicialComplexMCMC"], "[", 
   RowBox[{StyleBox["seedComplex", "TI"], ",", " ", StyleBox["operators", "TI"], ",", " ", StyleBox["labelingChoice", "TI"], ",", " ", StyleBox["numSamples", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5a809b5b-3dfe-4dfb-88b1-25ac93e2bf41"],
 "\[LineSeparator]draws ",
 Cell[BoxData[
  StyleBox["numSamples", "TI"]], "InlineFormula",ExpressionUUID->
  "208d40cb-2410-4b06-bbba-c3c73e4838db"],
 " pure simplicial complexes with the free-vertex Metropolis chain, which keeps the purity and facet order of ",
 Cell[BoxData[
  StyleBox["seedComplex", "TI"]], "InlineFormula",ExpressionUUID->
  "18679120-8efc-4677-a2f0-c2cdeacf12c3"],
 " and lets the vertex count vary.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0e8b2ecc-1a2b-4d4b-9ec2-174c922607e2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomPureSimplicialComplexMCMC",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/RandomPureSimplicialComplexMCMC"], "[", 
   RowBox[{StyleBox["seedComplex", "TI"], ",", " ", "True", ",", " ", StyleBox["operators", "TI"], ",", " ", StyleBox["labelingChoice", "TI"], ",", " ", StyleBox["numSamples", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1824cabd-efab-4362-85ba-710010b99139"],
 "\[LineSeparator]uses the fixed-vertex chain, which keeps the vertex set of ",
 Cell[BoxData[
  StyleBox["seedComplex", "TI"]], "InlineFormula",ExpressionUUID->
  "9fe03f7a-efc5-4fd3-8631-95a059e38a17"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"80f5fd3f-a3a0-479b-9f35-62d40b4288d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomPureSimplicialComplexMCMC",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/RandomPureSimplicialComplexMCMC"], "[", 
   RowBox[{StyleBox["priorRun", "TI"], ",", " ", StyleBox["operators", "TI"], ",", " ", StyleBox["labelingChoice", "TI"], ",", " ", StyleBox["numSamples", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cf66163e-84a2-4460-9624-393ce642f758"],
 "\[LineSeparator]continues a previous run from the association ",
 Cell[BoxData[
  StyleBox["priorRun", "TI"]], "InlineFormula",ExpressionUUID->
  "7bf3f053-1b0e-4d84-ae3f-becc5b85fa0b"],
 " that it returned, skipping equilibration and the correlation-time estimate.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a5b9b3ea-57fd-4b46-8be7-53796c6fe54e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomPureSimplicialComplexMCMC",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/RandomPureSimplicialComplexMCMC"], "[", 
   RowBox[{StyleBox["priorRun", "TI"], ",", " ", "True", ",", " ", StyleBox["operators", "TI"], ",", " ", StyleBox["labelingChoice", "TI"], ",", " ", StyleBox["numSamples", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c7460ff4-2559-40e6-8680-e9badd578391"],
 "\[LineSeparator]continues a previous fixed-vertex run."
}], "Usage",
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["labelingChoice selects the ensemble: 0 for vertex-labeled, in which every vertex-labeled complex is equally likely; 1 for facet-labeled; 2 for unlabeled, in which every isomorphism class is equally likely.", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"],

Cell["operators is a non-empty list of pure functions, each applied to a complex given as its list of facets.", "Notes",
 CellID->486132629,ExpressionUUID->"c0312ec2-5524-416d-8581-9f5c4f9865a4"],

Cell["A fresh run first equilibrates, printing diagnostic plots, then estimates the correlation time corrT, then takes numSamples samples corrT sweeps apart. A sweep is p M proposals, for purity p and facet order M.", "Notes",
 CellID->638052255,ExpressionUUID->"ad4a35c4-3ff8-468c-9325-54af3cd2aab9"],

Cell["The result is {measurements, info}. Each row of measurements is {k, energy, vertexCount, op1, \[Ellipsis], opm, complex}, where energy is -Log[w] for the target weight w; on the fixed-vertex chain the third entry is the number of edges of the 1-skeleton instead. info is an association with keys \"eqlT\", \"converged\", \"state\", \"corrT\", \"corrTValues\", \"corrTMeasured\", \"effectiveSampleSize\" and \"effectiveSampleSizeValues\". A continuation returns the prior run's association with the state and the effective sample sizes updated.", "Notes",
 CellID->567418298,ExpressionUUID->"3f141a9b-c6ac-4158-8067-b5d9ef34cf7e"],

Cell["Draws one correlation time apart remain correlated, typically at 0.2\[Dash]0.3 in the energy and the vertex count. info[\"effectiveSampleSize\"] is the smallest effective number of independent samples over the recorded observables, and info[\"effectiveSampleSizeValues\"] gives one per observable, in the order of info[\"corrTValues\"]; use these rather than numSamples for error bars. With fewer than 20 samples they are Missing[\[Ellipsis]].", "Notes",
 CellID->425093165,ExpressionUUID->"fde89825-c3a2-4dba-b276-b4d423733bbf"],

Cell["If equilibration does not converge within $ECGravMaxEquilibriationSweeps sweeps, a RandomPureSimplicialComplexMCMC::noneql message is issued and the result is $Failed.", "Notes",
 CellID->325314503,ExpressionUUID->"7519f6b8-abdf-44ae-8a84-6dab5477a047"]
}, Open  ]],

