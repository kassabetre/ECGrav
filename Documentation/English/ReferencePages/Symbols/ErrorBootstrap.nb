Notebook[{

Cell[CellGroupData[{
Cell["ErrorBootstrap", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e6d9c8bb-397d-4b8f-a799-63eb91ed76b0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ErrorBootstrap",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/ErrorBootstrap"], "[", 
   StyleBox[
    RowBox[{"formula_", ",", " ", "data_List"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"3f1a74c8-e6bd-486e-8370-b58844e577d3"],
 " estimates the uncertainty in ",
 Cell[BoxData[
  StyleBox["formula", "TI"]], "InlineFormula",ExpressionUUID->
  "e803740a-ac4d-4f0c-b439-de6e7fc09c58"],
 "[",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "cd162a71-55ad-43a3-84c5-eff23174de6d"],
 "] by the bootstrap (resampling) method (Newman & Barkema, \
\[Section]3.4.3)."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The data are resampled with replacement many times and the spread of formula \
over the resamples gives the error bar. The resampling runs in parallel, so \
the result is random and not fixed by SeedRandom alone.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

