Notebook[{

Cell[CellGroupData[{
Cell["LogSumExp", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"685c5f02-fd9b-4162-a231-ba4c5b9ecd32"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LogSumExp",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/LogSumExp"], "[", 
   StyleBox["lst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a39bd1bc-6ade-47bd-9f3c-6b214b723a7a"],
 " computes Log[\[Sum] Exp[",
 Cell[BoxData[
  StyleBox["lst", "TI"]], "InlineFormula",ExpressionUUID->
  "9fecf338-b97d-4d1e-9591-85358eda454a"],
 "]] in a numerically stable way."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Used throughout the free-energy machinery to combine log-weights without \
overflow. Equals Log[Total[Exp[lst]]] but avoids exponentiating large values \
directly.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

