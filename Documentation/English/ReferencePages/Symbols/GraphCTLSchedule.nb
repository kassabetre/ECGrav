Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initialize", " ", "inputs"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nn", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sdAm", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{"AdjacencyMatrix", "[", 
       RowBox[{"RandomGraph", "[", 
        RowBox[{"{", 
         RowBox[{"nn", ",", "6"}], "}"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bti", "=", "0.8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"btf", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"btTab", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"b", ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "bti", ",", "btf", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"btf", "-", "bti"}], ")"}], "/", "3"}]}], "}"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numEdges", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"am", ",", "2"}], "]"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numTriangles", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"am", ",", "3"}], "]"}], "]"}], "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numMesurements", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unlabeled", "=", "0"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"simulating", " ", "labeled", " ", "graphs"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numberOfExternalFieldValues", "=", "6"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "number", " ", "of", " ", "external", " ", "field", " ", 
     "values", " ", "to", " ", "be", " ", "returned", " ", "in", " ", "the", " ",
      "schedule"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.993902292461678*^9, 3.9939024283747063`*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"21bc2339-65e5-4c42-98aa-61433a925104"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Test", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"resCTL", "=", 
   RowBox[{"GraphCTLSchedule", "[", 
    RowBox[{"sdAm", ",", "btTab", ",", 
     RowBox[{"HIsing", "[", 
      RowBox[{
       RowBox[{"-", "1.0"}], ",", "0.0"}], "]"}], ",", 
     RowBox[{"delHIsing", "[", 
      RowBox[{
       RowBox[{"-", "1.0"}], ",", "0.0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"numEdges", "[", "#", "]"}], "&"}], ",", 
       RowBox[{
        RowBox[{"numTriangles", "[", "#", "]"}], "&"}]}], "}"}], ",", 
     "numMesurements", ",", "unlabeled", ",", "numberOfExternalFieldValues"}],
     "]"}]}]}]], "Input",
 CellChangeTimes->{{3.967815931217053*^9, 3.967815931606544*^9}, {
