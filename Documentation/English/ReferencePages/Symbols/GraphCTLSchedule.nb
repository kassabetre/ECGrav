Cell["GraphCTLSchedule", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8a0873f1-3e7a-4086-896b-a50dd062d952"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphCTLSchedule",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphCTLSchedule"], "[", 
   StyleBox[
    RowBox[{"seedGraph_", ",", " ", "btTable_", ",", " ", 
     RowBox[{"H_", "[", "params___", "]"}], ",", " ", 
     RowBox[{"delH_", "[", "params___", "]"}], ",", " ", "obs_", ",", " ", 
     "NN_", ",", " ", "unlabeled_", ",", " ", 
     RowBox[{"numReplicas_", ":", "$KernelCount"}]}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"22500855-f367-4377-851a-f4a4a8d1b381"],
 " finds an inverse-temperature schedule for parallel tempering that keeps \
swap-acceptance ratios roughly constant, using the \
constant-thermodynamic-length (CTL) approach."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Overloads find an external-field schedule at fixed temperature, or build a \
schedule directly from the -\[Beta]F and energy associations produced by a \
previous GraphMultiHistogram / GraphCTLSchedule run. Returns {min-energy \
association, temperature schedule, per-temperature data, final replicas}. \
Expensive and stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

