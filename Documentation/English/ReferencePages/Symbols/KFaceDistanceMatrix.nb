Notebook[{

Cell[CellGroupData[{
Cell["KFaceDistanceMatrix", "ObjectName",
 CellID->115706015,ExpressionUUID->"2dade8b0-9076-bf41-a143-7b77dbccc10b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"08cdf0d8-beb8-874f-91e2-498d32e428ef"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["KFaceDistanceMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/KFaceDistanceMatrix"], "[", 
   RowBox[{
    StyleBox["facetsLst_List", "TI"], ",", 
    StyleBox["k_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b28e4248-d525-5541-9900-b79b8f8d3d5b"],
 "\[LineSeparator]Given a \tsimplicial complex as a list of facets ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "3778e174-b278-424c-a442-af7a1214fcf0"],
 " and dimensionality ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "905b6860-ed7f-404d-ad57-dc611f78e120"],
 ", it computes the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "017e45e1-9b58-6b4f-b602-32e98d18cbc1"],
 "-face distance matrix between every pair of faces of cardinality facedim, \
where each path steps on only (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "f99cd3ca-7b55-534a-b148-4f3bafe9797e"],
 "+1)-dimensional faces. It uses the built in Mathematica GraphDistanceMatrix \
function on a graph constructed such that the vertices are all clqdim-faces \
and edges between them are 1 if two faces are contained in a bigger clique \
and 0 otherwise."
}], "Usage",
 CellChangeTimes->{{3.971900227439312*^9, 3.971900319310091*^9}, {
  3.9719004176059227`*^9, 3.9719004344878235`*^9}, {3.971912538351532*^9, 
  3.9719125416089764`*^9}, {3.9719129014634457`*^9, 3.9719129072162437`*^9}},
 CellID->122694607,ExpressionUUID->"5a1d97a7-74d1-7443-b905-bd07492d692f"],

