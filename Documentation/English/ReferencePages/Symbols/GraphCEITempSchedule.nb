Cell[CellGroupData[{
Cell["GraphCEITempSchedule", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ffb7116f-9f1e-4023-84fb-c308bed57f03"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphCEITempSchedule",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphCEITempSchedule"], "[", 
   StyleBox[
    RowBox[{
    "seedGraph_", ",", " ", "betaLow_", ",", " ", "betaHigh_", ",", " ", 
     RowBox[{"H_", "[", "params___", "]"}], ",", " ", "obs_", ",", " ", "NN_",
      ",", " ", "unlabeled_"}], "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "afef4186-4915-4178-97ee-c95585fdd2ac"],
 " finds an inverse-temperature schedule for parallel tempering between ",
 Cell[BoxData[
  StyleBox["betaLow", "TI"]], "InlineFormula",ExpressionUUID->
  "8f704b21-f0fb-426b-afcb-884643457f6a"],
 " and ",
 Cell[BoxData[
  StyleBox["betaHigh", "TI"]], "InlineFormula",ExpressionUUID->
  "4f98b1ea-f52e-4a04-a8f3-2ca4c5451072"],
 " using the constant-entropy-increase (CEI) approach of Sabo et al."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
An overload accepts an explicit list of inverse temperatures. Returns \
{min-energy association, temperature schedule, per-temperature data, final \
replicas}. Its schedule feeds GraphParallelTempering. Expensive and \
stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

