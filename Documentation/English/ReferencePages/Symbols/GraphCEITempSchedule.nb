Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initialize", " ", "inputs"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nn", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sdAm", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{"AdjacencyMatrix", "[", 
       RowBox[{"RandomGraph", "[", 
        RowBox[{"{", 
         RowBox[{"nn", ",", "6"}], "}"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bti", "=", "0.8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"btf", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"btTab", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"b", ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "bti", ",", "btf", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"btf", "-", "bti"}], ")"}], "/", "4"}]}], "}"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numEdges", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"am", ",", "2"}], "]"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numTriangles", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"am", ",", "3"}], "]"}], "]"}], "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numMesurements", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unlabeled", "=", "0"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"simulating", " ", "labeled", " ", "graphs"}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9937366540313587`*^9, 3.993736673817939*^9}, {
  3.993902013568955*^9, 3.993902047441218*^9}, {3.993902087969574*^9, 
