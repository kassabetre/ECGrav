Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\" relabelingRule \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "4"}], ",", 
     RowBox[{"2", "\[Rule]", "5"}], ",", 
     RowBox[{"6", "\[Rule]", "1"}], ",", 
     RowBox[{"3", "\[Rule]", "6"}], ",", 
     RowBox[{"4", "\[Rule]", "2"}], ",", 
     RowBox[{"5", "\[Rule]", "3"}]}], "}"}], 
   "\[InvisibleSpace]", "\<\" inverseRelabelingRule \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"4", "\[Rule]", "1"}], ",", 
     RowBox[{"5", "\[Rule]", "2"}], ",", 
     RowBox[{"1", "\[Rule]", "6"}], ",", 
     RowBox[{"6", "\[Rule]", "3"}], ",", 
     RowBox[{"2", "\[Rule]", "4"}], ",", 
     RowBox[{"3", "\[Rule]", "5"}]}], "}"}]}],
  SequenceForm[
  " relabelingRule ", {1 -> 4, 2 -> 5, 6 -> 1, 3 -> 6, 4 -> 2, 5 -> 3}, 
   " inverseRelabelingRule ", {
   4 -> 1, 5 -> 2, 1 -> 6, 6 -> 3, 2 -> 4, 3 -> 5}],
  Editable->False]], "Print",
 CellChangeTimes->{
  3.9744807160906105`*^9, {3.974480746304903*^9, 3.9744807509010983`*^9}, 
