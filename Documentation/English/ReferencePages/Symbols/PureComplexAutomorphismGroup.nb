Cell[CellGroupData[{
Cell["PureComplexAutomorphismGroup", "ObjectName",
 CellID->202533555,ExpressionUUID->"808c0aa0-d558-764a-8c84-4ee39073f93d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b6cdaee-bb50-9c45-b0b6-06fe57e9f326"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PureComplexAutomorphismGroup",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/PureComplexAutomorphismGroup"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ce05c7aa-9ed7-1c42-b15d-a820f1499f31"],
 "\[LineSeparator]returns \ta list {a,b} where a is the automorphism group of \
the canonically relabeled version of the input complex (given as a list ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "cfb91fd6-8ca0-3247-86c2-b5f3f91bb1b8"],
 " of facets), and b is the vertex relabeling rule from ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "6796b795-5b44-5d42-a1af-14548d84fddf"],
 " to the canonically labeled version."
}], "Usage",
 CellChangeTimes->{{3.974480620010645*^9, 3.9744806450938168`*^9}},
 CellID->36913809,ExpressionUUID->"c52dfbaf-72fa-d449-8dcc-b619046b22b5"],

