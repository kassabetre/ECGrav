Cell[CellGroupData[{
Cell["Branchedness", "ObjectName",
 CellID->149093015,ExpressionUUID->"4cf3e6da-0194-2148-ae07-aea664519261"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"17a98382-8bde-f84f-a8db-a065dd341886"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Branchedness",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/Branchedness"], "[", 
   RowBox[{
    StyleBox["g_Graph", "TI"], ",", 
    StyleBox["n_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "df83f79b-c41c-ad4e-b93d-298cfd440d44"],
 "\[LineSeparator]Given a graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "06072bb9-d9fd-6c49-a409-2017da7552d2"],
 " and a dimension ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "83410095-a109-7a44-859b-86b9b00b8e14"],
 ", it computes the rms value of the degree of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "5f1380c5-295a-0e45-9fb0-8ace5162dd2f"],
 "-facets, minus 3/2. This quantity will be zero for pseudo manifolds if ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "d37784d8-9598-fa48-92db-7ba02836691a"],
 " is the purity of the graph minus one since all codimension 1 faces have \
degree 1 or 2. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"06e16e40-3114-f647-8cc7-961583cf82c9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Branchedness",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/Branchedness"], "[", 
   StyleBox["g_Graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b445d8c8-f2e9-d948-b46c-a75a7945ef8e"],
 "\[LineSeparator]Given a graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "aff2ef53-2047-eb47-8b0c-411596426fb3"],
 " with dimension n, it computes the rms value of the degree of the n-facets, \
minus 3/2. This quantity will be zero for pseudo manifolds if n is the purity \
of the graph minus one since all codimension 1 faces have degree 1 or 2. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8673d79f-461c-fd48-9473-869187873b93"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Branchedness",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/Branchedness"], "[", 
   RowBox[{
    StyleBox["Amat_List", "TI"], ",", 
    StyleBox["n_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7d189b29-e329-4648-860d-da81cb83f6f6"],
 "\[LineSeparator]Given a graph as an adjacency matrix ",
 Cell[BoxData[
  StyleBox["Amat", "TI"]], "InlineFormula",ExpressionUUID->
  "d9332974-db42-cb48-98d5-d8573a96b9fe"],
 " and a dimension ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "ec06a78b-b9a0-2c41-a2a1-ff87b4acae8d"],
 ", it computes the rms value of the degree of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "236f890d-c170-2e45-bb43-203e7f60107b"],
 "-facets, minus 3/2. This quantity will be zero for pseudo manifolds if ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "3c6f023d-2c17-e243-8203-acce21ca03c0"],
 " is the purity of the graph minus one since all codimension 1 faces have \
degree 1 or 2. \t\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2edf4d50-d7e0-f847-8c11-721aed2371be"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Branchedness",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/Branchedness"], "[", "Amat", "]"}]], 
  "InlineFormula",ExpressionUUID->"07a16ef5-3d28-0440-81d0-bbf3dd4a7881"],
 "\[LineSeparator]Given a graph as an adjacency matrix ",
 Cell[BoxData[
  StyleBox["Amat", "TI"]], "InlineFormula",ExpressionUUID->
  "9d057f47-599b-ca4b-8e94-bc09562b8950"],
 " with dimension n, it computes the rms value of the degree of the n-facets, \
minus 3/2. This quantity will be zero for pseudo manifolds if n is the purity \
of the graph minus one since all codimension 1 faces have degree 1 or 2. "
}], "Usage",
