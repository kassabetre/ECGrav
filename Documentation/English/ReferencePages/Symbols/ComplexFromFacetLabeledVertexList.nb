Cell["A vertex labeled graph, g:", "ExampleText",
 CellChangeTimes->{3.9707765681376*^9},
 CellID->106893938,ExpressionUUID->"cfd60251-591c-7644-8f3e-0b7363036a02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "\[UndirectedEdge]", "2"}], ",", 
      RowBox[{"2", "\[UndirectedEdge]", "3"}], ",", 
      RowBox[{"3", "\[UndirectedEdge]", "4"}], ",", 
      RowBox[{"1", "\[UndirectedEdge]", "3"}]}], "}"}], ",", 
    RowBox[{"VertexLabels", "\[Rule]", "\"\<Name\>\""}], ",", 
    RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}]], "Input",
 CellLabel->"In[92]:=",
 CellID->382140595,ExpressionUUID->"a83d48c3-7398-a24c-a39e-3c0610494dc0"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, {{1, 2}, {2, 3}, {3, 4}, {1, 3}}}, {
      ImageSize -> Medium, VertexLabels -> {"Name"}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[0.], 
        ArrowBox[{{{0.0001964751172666146, 0.}, {0., 0.8475386976306538}}, {{
         0.0001964751172666146, 0.}, {0.9164048379140673, 
         0.42386488156829044`}}, {{0., 0.8475386976306538}, {
         0.9164048379140673, 0.42386488156829044`}}, {{0.9164048379140673, 
         0.42386488156829044`}, {2.031430211699506, 0.42382043094346533`}}}, 
         0.022865977658369868`]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[
        0.7]}], {DiskBox[{0.0001964751172666146, 0.}, 0.022865977658369868], 
         InsetBox["1", 
          Offset[{2, 2}, {0.023062452775636483, 0.022865977658369868}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{0., 0.8475386976306538}, 0.022865977658369868], 
         InsetBox["2", 
          Offset[{2, 2}, {0.022865977658369868, 0.8704046752890237}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{0.9164048379140673, 0.42386488156829044`}, 
          0.022865977658369868], 
         InsetBox["3", 
          Offset[{2, 2}, {0.9392708155724372, 0.44673085922666034}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{2.031430211699506, 0.42382043094346533`}, 
          0.022865977658369868], 
         InsetBox["4", 
          Offset[{2, 2}, {2.054296189357876, 0.44668640860183517}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None,
  ImageSize->Medium]], "Output",
 CellChangeTimes->{3.970776862263012*^9, 3.9707840806992455`*^9},
 CellLabel->"Out[92]=",
 CellID->49557584,ExpressionUUID->"79a0110b-abcf-374e-8955-89fbf4adf45c"]
}, Open  ]],

Cell["\<\
Facets can be labeled in any manner. Suppose we label in descending canonical \
order (i.e., by largest cardinality, then smallest number).\
\>", "ExampleText",
 CellChangeTimes->{{3.9707841614335823`*^9, 3.970784221537142*^9}, 
   3.97078429227009*^9, {3.97078545470245*^9, 3.970785471406492*^9}, {
   3.970785719160166*^9, 3.9707857394377213`*^9}},
 CellID->50079376,ExpressionUUID->"8d859d68-8344-3a49-8fb0-ae1f39cda42b"],

Cell["\<\
As a clique complex, facet 1 would be {1,2,3} and facet 2 would be {3,4}.\
\>", "ExampleText",
 CellChangeTimes->{{3.970785751436474*^9, 3.970785769723852*^9}, {
  3.9718853489659824`*^9, 3.971885353951454*^9}},
 CellID->187968968,ExpressionUUID->"dfcc1216-22e2-bd4d-90ca-0e597dcb754f"],

Cell["\<\
Re-labeling each vertex by the facet it belongs to, gives us:\
\>", "ExampleText",
 CellChangeTimes->{{3.9707767036151047`*^9, 3.970776710606497*^9}, {
  3.9707768831228104`*^9, 3.9707769035627785`*^9}},
 CellID->33521124,ExpressionUUID->"746d97aa-e735-cd40-8c43-63f1dac61858"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"vertices", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "1", "}"}], ",", 
    RowBox[{"{", "1", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", "2", "}"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.97077691223794*^9, 3.97077693880814*^9}, {
  3.970777016354679*^9, 3.9707770412523155`*^9}, {3.9707840898898335`*^9, 
  3.970784090582552*^9}, {3.9707858559398727`*^9, 3.970785862467785*^9}},
 CellLabel->"In[103]:=",
 CellID->108364005,ExpressionUUID->"73a6acdf-d3fb-2246-8804-327db0ab6b2f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "2", "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.970785781540884*^9, 3.9707858639539337`*^9},
 CellLabel->"Out[103]=",
 CellID->399312775,ExpressionUUID->"580a07fe-5f63-544d-8e17-cd9efb4a250c"]
}, Open  ]],

