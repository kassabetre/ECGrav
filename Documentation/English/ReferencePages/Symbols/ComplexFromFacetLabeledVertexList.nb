Cell[CellGroupData[{
Cell["ComplexFromFacetLabeledVertexList", "ObjectName",
 CellID->186804482,ExpressionUUID->"7f38720c-6a63-a043-a762-d6606ec163d6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"79654592-ed01-7845-a52c-60636ef4cfd2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ComplexFromFacetLabeledVertexList",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/ComplexFromFacetLabeledVertexList"], "[", 
   StyleBox["facetLabeledVertices", "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"563c41a5-ab83-2246-a935-fa831dff13be"],
 "\[LineSeparator]returns the complex as a list of facets in canonical order \
given an input as a list of vertices re-labeled by the facets they belong to \
in normal order (i.e., a facet-labeled complex)."
}], "Usage",
 CellChangeTimes->{{3.9707760111010265`*^9, 3.9707760166469803`*^9}, {
  3.97077605159054*^9, 3.9707760559763203`*^9}, {3.970776138273735*^9, 
