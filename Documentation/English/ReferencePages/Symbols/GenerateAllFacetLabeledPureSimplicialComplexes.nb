Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d26c3361-486c-4141-9b4c-2a7d7a2a94ad"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateAllFacetLabeledPureSimplicialComplexes",
    BaseStyle->"Link",
    ButtonData->
     "paclet:ECGrav/ref/GenerateAllFacetLabeledPureSimplicialComplexes"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p_Integer", "TI"], ",", 
     StyleBox["q_Integer", "TI"]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"ab36aad5-d4a6-8f4c-931b-bf619999922e"],
 "\[LineSeparator]returns a list of all facet-labeled ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "c5913d30-d5e7-ac42-97be-5a5bde10757e"],
 "-pure simplicial complexes of facet-order ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",ExpressionUUID->
  "80c27af6-987b-8347-9029-48035090879c"],
 ", where each simplicial complex is represented as a list of its facets."
}], "Usage",
