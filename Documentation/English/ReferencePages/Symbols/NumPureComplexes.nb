Notebook[{

Cell[CellGroupData[{
Cell["NumPureComplexes", "ObjectName",
 CellID->947977364,ExpressionUUID->"bb0483e1-c588-44bf-a7fd-8cc93f4604b6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["NumPureComplexes",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NumPureComplexes"], "[", 
   RowBox[{
    StyleBox["p_Integer", "TI"], ",", 
    StyleBox["M_Integer", "TI"], ",", 
    StyleBox["n_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8f876ee5-0dda-400d-8bd3-18048bab0f7f"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NumPureComplexes",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NumPureComplexes"], "[", 
   RowBox[{
    StyleBox["p_Integer", "TI"], ",", 
    StyleBox["M_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ed780c5f-234e-42e9-9df9-b25cd502e947"],
 " are the former name of ",
 Cell[BoxData[
  ButtonBox["NumVertexLabeledPureComplexes",
   BaseStyle->"Link",
   ButtonData->"paclet:ECGrav/ref/NumVertexLabeledPureComplexes"]], 
  "InlineFormula",ExpressionUUID->"32053dea-8eb2-4886-ac0c-9d18bebe8eb5"],
 ", kept as an alias for it with the same arguments in the same order."
}], "Usage",
 CellChangeTimes->{{3.970835558127205*^9, 3.970835596963972*^9}},
 CellID->406865611,ExpressionUUID->"379de485-ee02-4819-b094-38e1e7116999"],

Cell[TextData[{
 "The rename did not change the argument order, which is still purity, facet \
order, vertex count \[LongDash] the facet order simply written ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "10ede927-938d-4b0e-becb-2d32006baa13"],
 " rather than ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",ExpressionUUID->
  "87b52a59-a89d-4114-9a7e-5c4bd8612dfe"],
 ". Existing code therefore keeps returning what it always did. Prefer ",
 Cell[BoxData[
  ButtonBox["NumVertexLabeledPureComplexes",
   BaseStyle->"Link",
   ButtonData->"paclet:ECGrav/ref/NumVertexLabeledPureComplexes"]], 
  "InlineFormula",ExpressionUUID->"afc5ddab-ed79-4efe-9cd4-14b5c3ed71f2"],
 " in new work, since it says which of the two labelings it counts."
}], "Notes",
 CellID->556270747,ExpressionUUID->"801ab2fa-9afb-4404-b104-3995073ae680"]
}, Open  ]],

