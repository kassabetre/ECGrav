Notebook[{

Cell[CellGroupData[{
Cell["GraphEquilibriate", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a4b1379-ecc6-4638-b154-1412da9b70d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphEquilibriate",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphEquilibriate"], "[", 
   StyleBox[
    RowBox[{"seedGraph_", ",", " ", "beta_", ",", " ", 
     RowBox[{"H_", "[", "params___", "]"}], ",", " ", "unlabeled_"}], "TI"], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "4a810d32-67cf-48e3-8ee5-162ee096e6db"],
 " equilibrates the seed graph ",
 Cell[BoxData[
  StyleBox["seedGraph", "TI"]], "InlineFormula",ExpressionUUID->
  "9472ce89-4369-4c7c-857a-afe43f599276"],
 " to inverse temperature ",
 Cell[BoxData[
  StyleBox["beta", "TI"]], "InlineFormula",ExpressionUUID->
  "3a61fb0a-16eb-45ea-a64d-3e32aea3d091"],
 ", returning {minimum-energy association, equilibrated-state association}. \
An overload inserts a delta-energy formula delH[params]."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The Hamiltonian is passed as an inert head with parameters (see \
GraphSweepReplica). The run emits an energy-vs-time diagnostic plot and its \
result feeds GraphComputeCorrelationTime. unlabeled = 0 or 1. Results are \
stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

