Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initialize", " ", "inputs"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nn", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"sdAm", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", "nn", "}"}], ",", 
      RowBox[{"{", "nn", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", "am_List", "]"}], ":=", 
     RowBox[{"HIsing", "[", 
      RowBox[{"am", ",", 
       RowBox[{"-", "1.0"}], ",", "0.0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH", "[", 
      RowBox[{"am_List", ",", "i_Integer", ",", "j_Integer"}], "]"}], ":=", 
     RowBox[{"delHIsing", "[", 
      RowBox[{"am", ",", 
       RowBox[{"-", "1.0"}], ",", "0.0", ",", "i", ",", "j"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numEdges", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"am", ",", "2"}], "]"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numTriangles", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"am", ",", "2"}], "]"}], "]"}], "/", "6"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9937321887600117`*^9, 3.993732241672696*^9}, {
  3.993732362788747*^9, 3.993732376595873*^9}, {3.993732430884014*^9, 
