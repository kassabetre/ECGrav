Cell[CellGroupData[{
Cell["GraphMetropolis", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dcbcb2b3-64aa-4c40-90ad-fc4767902890"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphMetropolis",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphMetropolis"], "[", 
   StyleBox[
    RowBox[{
    "seedAmat_", ",", " ", "beta_", ",", " ", "H_", ",", " ", "observables_", 
     ",", " ", "maxSweep_"}], "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3b979c34-dd3c-4434-b48f-2a0f25adaa89"],
 " runs a Metropolis Monte Carlo simulation from the seed adjacency matrix ",
 Cell[BoxData[
  StyleBox["seedAmat", "TI"]], "InlineFormula",ExpressionUUID->
  "f45fbca4-4415-48c8-bf23-9e3a93501af3"],
 " at inverse temperature ",
 Cell[BoxData[
  StyleBox["beta", "TI"]], "InlineFormula",ExpressionUUID->
  "c1b7a2f9-cdcc-4b33-a4d5-b7a1865312ce"],
 " with Hamiltonian ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",ExpressionUUID->
  "6c37fa0b-fc7a-4a2c-9f9d-cd0b4a69f18d"],
 " for ",
 Cell[BoxData[
  StyleBox["maxSweep", "TI"]], "InlineFormula",ExpressionUUID->
  "3e30a1f3-e732-435d-9e90-ec621133d738"],
 " sweeps (one sweep = N(N-1)/2 edge-flip attempts). It returns {final \
adjacency matrix, time series of the ",
 Cell[BoxData[
  StyleBox["observables", "TI"]], "InlineFormula",ExpressionUUID->
  "3b5d80e1-914d-4309-be73-b49f752bc322"],
 "}."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The Hamiltonian is supplied as a one-argument pure function of an adjacency \
matrix, e.g. HIsing[#,-1.,0.]&. Results are stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

