Notebook[{

Cell[CellGroupData[{
Cell["GraphComputeCorrelationTime", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9fd26b97-0465-419a-bef1-9265f60ebbdd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphComputeCorrelationTime",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphComputeCorrelationTime"], "[", 
   StyleBox[
    RowBox[{"seedGraph_", ",", " ", "beta_", ",", " ", 
     RowBox[{"H_", "[", "params___", "]"}], ",", " ", "eqlT_", ",", " ", 
     "minEToBeat_", ",", " ", "EnergyOrMag_", ",", " ", "unlabeled_"}], "TI"],
    "]"}]], "InlineFormula",ExpressionUUID->
  "53bd2289-ab58-4e7c-bcbb-53b5f42b7363"],
 " estimates the autocorrelation time of the equilibrated chain at inverse \
temperature ",
 Cell[BoxData[
  StyleBox["beta", "TI"]], "InlineFormula",ExpressionUUID->
  "6dad3b16-a8fc-471e-8c48-01389141c790"],
 ", given the equilibration time ",
 Cell[BoxData[
  StyleBox["eqlT", "TI"]], "InlineFormula",ExpressionUUID->
  "6e126f5d-5a1a-4b3f-8280-2b521838ac93"],
 ". ",
 Cell[BoxData[
  StyleBox["EnergyOrMag", "TI"]], "InlineFormula",ExpressionUUID->
  "c032b190-a2b9-4fd8-b26e-bcddd2418b31"],
 " selects energy (0) or magnetization (1); an overload accepts a list of \
observables instead."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The Hamiltonian is passed as an inert head with parameters (see \
GraphSweepReplica). The run emits an autocorrelation diagnostic plot. Depends \
on GraphSweepReplica and CorrelationTime. Results are stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

