Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initialize", " ", "inputs"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nn", "=", "6"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"sdAm", "=", 
    RowBox[{"Normal", "[", 
     RowBox[{"AdjacencyMatrix", "[", 
      RowBox[{"RandomGraph", "[", 
       RowBox[{"{", 
        RowBox[{"nn", ",", "6"}], "}"}], "]"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bt", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numEdges", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"am", ",", "2"}], "]"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numTriangles", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"am", ",", "3"}], "]"}], "]"}], "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"GraphEquilibriate", "[", 
    RowBox[{"sdAm", ",", "bt", ",", 
     RowBox[{"HIsing", "[", 
      RowBox[{
       RowBox[{"-", "1.0"}], ",", "0.0"}], "]"}], ",", 
     RowBox[{"delHIsing", "[", 
      RowBox[{
       RowBox[{"-", "1.0"}], ",", "0.0"}], "]"}], ",", "0"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.967716498238617*^9, 3.967716502738027*^9}, {
