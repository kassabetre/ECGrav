Notebook[{

Cell[CellGroupData[{
Cell["RandomPureSimplicialComplexMCMCCorrelationTime", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0ec4573b-50d0-478a-a7f7-41b0d0b1bb2e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomPureSimplicialComplexMCMCCorrelationTime",
    BaseStyle->"Link",
    ButtonData->
     "paclet:ECGrav/ref/RandomPureSimplicialComplexMCMCCorrelationTime"], "[", 
   StyleBox[
    RowBox[{
    "equilibriatedComplex_List", ",", " ", "eqlT_Integer", ",", " ", 
     "operators_", ",", " ", "labelingChoise_Integer"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"623da4ae-5a38-4b35-9a11-d6d418b6bbd3"],
 " estimates the autocorrelation time of the equilibrated chain, tracking the \
energy, the edge count, and the observables ",
 Cell[BoxData[
  StyleBox["operators", "TI"]], "InlineFormula",ExpressionUUID->
  "60587b51-4fc1-4ff4-9453-4e421fe701b6"],
 " (a non-empty list of pure functions). It returns an association with \
\"eqlT\", \"corrT\", \"corrTValues\", and \"state\"."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The reported correlation time is the maximum over the energy = \
-Log[probability], the edge-count observable, and each user-supplied \
observable. operators must match {__Function}.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

