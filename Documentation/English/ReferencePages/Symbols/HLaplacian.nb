Notebook[{

Cell[CellGroupData[{
Cell["HLaplacian", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"694200a8-1c36-4794-a0e6-32ab5fb05d40"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HLaplacian",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/HLaplacian"], "[", 
   StyleBox[
    RowBox[{"Am_List", ",", " ", "J_"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"b263413f-7638-45d4-a826-1f1d6e902815"],
 " gives ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",ExpressionUUID->
  "f1915ec7-6e43-4369-ad4c-d806272f6f68"],
 "\[Times]\[Sum] deg(i) L",
 Cell[BoxData[
  SubscriptBox["", "ij"]], "InlineFormula",ExpressionUUID->
  "9f22aa3b-2e50-4b3a-99f6-e225c5e29f66"],
 " deg(j) for the graph with adjacency matrix ",
 Cell[BoxData[
  StyleBox["Am", "TI"]], "InlineFormula",ExpressionUUID->
  "2406042d-c076-430a-8439-ef1141bbea43"],
 ", where L = Diag[deg] - Am is the graph Laplacian."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
This energy vanishes on every regular graph (all vertices of equal degree), \
since the Laplacian annihilates the constant degree vector. It is nonzero \
only when the degree sequence is non-uniform.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

