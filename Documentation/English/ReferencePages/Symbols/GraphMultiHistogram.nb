Notebook[{

Cell[CellGroupData[{
Cell["GraphMultiHistogram", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"10074e67-20cb-4465-81a2-4d57c1c7dbbe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphMultiHistogram",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphMultiHistogram"], "[", 
   StyleBox[
    RowBox[{
    "seedGraph_", ",", " ", "betaLow_", ",", " ", "betaHigh_", ",", " ", 
     RowBox[{"H_", "[", "params___", "]"}], ",", " ", "obs_", ",", " ", "NN_",
      ",", " ", "unlabeled_"}], "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "38ff1484-9385-4113-9513-80ad26c36e73"],
 " applies the multiple-histogram method between inverse temperatures ",
 Cell[BoxData[
  StyleBox["betaLow", "TI"]], "InlineFormula",ExpressionUUID->
  "696f8b81-4ccb-4826-82e7-0fa974a5a8ce"],
 " and ",
 Cell[BoxData[
  StyleBox["betaHigh", "TI"]], "InlineFormula",ExpressionUUID->
  "67e93c4b-1d63-47a2-a52f-a3ddf91e7dac"],
 " to produce smooth curves of the observables ",
 Cell[BoxData[
  StyleBox["obs", "TI"]], "InlineFormula",ExpressionUUID->
  "07dbb5a6-f5ed-4049-8b09-ba8e888befee"],
 " versus inverse temperature. It equilibrates, estimates correlation times, \
takes ",
 Cell[BoxData[
  StyleBox["NN", "TI"]], "InlineFormula",ExpressionUUID->
  "1684e205-35eb-4601-829c-45b520e247da"],
 " measurements, and computes the free energies used for extrapolation."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Overloads accept an explicit list of inverse temperatures, an optional \
delH[params], or an external-field schedule. Returns {min-energy association, \
per-temperature -\[Beta]F/energy/observable data, final replicas}. Feeds \
InternalEnergy, ExtrapolatedExpectationValue, etc. Expensive and stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

