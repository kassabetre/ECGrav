        RowBox[{"am", ",", "3"}], "]"}], "]"}], "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numMesurements", "=", "20"}], ";"}], "\[IndentingNewLine]", 
