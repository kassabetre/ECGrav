Notebook[{

Cell[CellGroupData[{
Cell["GraphParallelTempering", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"132527e1-7227-4a1c-9c74-dda537550953"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphParallelTempering",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphParallelTempering"], "[", 
   StyleBox[
    RowBox[{
    "seedGraph_", ",", " ", "btTable_", ",", " ", "minEToBeat_", ",", " ", 
     RowBox[{"H_", "[", "params___", "]"}], ",", " ", 
     RowBox[{"delH_", "[", "params___", "]"}], ",", " ", "obs_", ",", " ", 
     "EnergyOrMag_", ",", " ", "NN_", ",", " ", "unlabeled_"}], "TI"], "]"}]],
   "InlineFormula",ExpressionUUID->"da501f63-d52d-4897-85c7-364ffd76cc09"],
 " runs parallel tempering across the inverse-temperature schedule ",
 Cell[BoxData[
  StyleBox["btTable", "TI"]], "InlineFormula",ExpressionUUID->
  "f5360fcb-e08a-4fd5-b45c-4e6692ed79c6"],
 ", equilibrating, estimating correlation times, then taking ",
 Cell[BoxData[
  StyleBox["NN", "TI"]], "InlineFormula",ExpressionUUID->
  "87b7c0bf-43ee-4bad-973f-34290cc94b3a"],
 " measurements of the observables ",
 Cell[BoxData[
  StyleBox["obs", "TI"]], "InlineFormula",ExpressionUUID->
  "674b9afe-9968-49e0-b91c-ec8c29c1a18c"],
 " with temperature swaps."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The schedule btTable should come from GraphCEITempSchedule or \
GraphCTLSchedule. Equilibration, correlation-time estimation, and measurement \
sweeps run in parallel; swaps are done on the master kernel. An overload \
takes a prior run's replica association in place of {seedGraph, btTable}. \
Returns {min-energy association, per-temperature measurements, final \
replicas, per-replica history}. Expensive and stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

