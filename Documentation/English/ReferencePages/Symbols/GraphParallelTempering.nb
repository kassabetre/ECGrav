Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initialize", " ", "inputs"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nn", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sdAm", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{"AdjacencyMatrix", "[", 
       RowBox[{"RandomGraph", "[", 
        RowBox[{"{", 
         RowBox[{"nn", ",", "6"}], "}"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bti", "=", "0.7"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"btf", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"btTab", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"b", ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "bti", ",", "btf", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"btf", "-", "bti"}], ")"}], "/", "4"}]}], "}"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numEdges", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"am", ",", "2"}], "]"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"numTriangles", "[", "am_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"am", ",", "3"}], "]"}], "]"}], "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numMesurements", "=", "40"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unlabeled", "=", "0"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"simulating", " ", "labeled", " ", "graphs"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minEValForSaving", "=", "5.0"}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "a", " ", "cutoff", " ", "energy", " ", "value", " ", "such", " ", "that",
      " ", "states", " ", "with", " ", "energy", " ", "below", " ", "above", " ",
      "this", " ", "will", " ", "not", " ", "be", " ", "considered", " ", 
     "as", " ", "candidate", " ", "ground", " ", "states"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numberOfExternalFieldValues", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"btSchedule", "=", 
    RowBox[{"First", "[", 
     RowBox[{"GraphCTLSchedule", "[", 
      RowBox[{"sdAm", ",", "btTab", ",", 
       RowBox[{"HIsing", "[", 
        RowBox[{
         RowBox[{"-", "1.0"}], ",", "0.0"}], "]"}], ",", 
       RowBox[{"delHIsing", "[", 
        RowBox[{
         RowBox[{"-", "1.0"}], ",", "0.0"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"numEdges", "[", "#", "]"}], "&"}], ",", 
         RowBox[{
          RowBox[{"numTriangles", "[", "#", "]"}], "&"}]}], "}"}], ",", 
       RowBox[{"2", "*", "numMesurements"}], ",", "unlabeled", ",", 
       "numberOfExternalFieldValues"}], "]"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.993738867486397*^9, 3.9937388677572536`*^9}, {
  3.9939045572078648`*^9, 3.993904636616166*^9}, {3.993904677344845*^9, 
  3.993904738454974*^9}, {3.993905197123271*^9, 3.9939052166328297`*^9}, {
