Cell["IsContainedSimplicialComp", "ObjectName",
 CellID->280161866,ExpressionUUID->"2f86c5f8-50fc-1443-ac2a-b758556ef125"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bd40e809-5f9e-a242-ac6f-b0d26f5ad78b"],
 Cell[BoxData[
  ButtonBox["IsContainedSimplicialComp",
   BaseStyle->"Link",
   ButtonData->"paclet:ECGrav/ref/IsContainedSimplicialComp"]], 
  "InlineFormula",ExpressionUUID->"b9eb1138-f43a-2740-bdc9-f77297b02ee4"],
 "[",
 Cell[BoxData[
  StyleBox["xList_List", "TI"]], "InlineFormula",ExpressionUUID->
  "259f957a-2036-3949-bc9a-deb8e31e2991"],
 ", ",
 Cell[BoxData[
  StyleBox["cmpx_List", "TI"]], "InlineFormula",ExpressionUUID->
  "51e63dc2-0bc5-7b44-9ea3-76d2332ead72"],
 "]\[LineSeparator]Given a list of simplicial complexes ",
 Cell[BoxData[
  StyleBox["xList", "TI"]], "InlineFormula",ExpressionUUID->
  "692fd8bc-fedb-9f4c-a510-f0565861f0ca"],
 " (each given as a list of facets), and a single other simplicial complex ",
 Cell[BoxData[
  StyleBox["cmpx", "TI"]], "InlineFormula",ExpressionUUID->
  "5f7581fd-a2ca-9e46-af5b-fbe59058033a"],
 ", IsContainedSimplicialComp[",
 Cell[BoxData[
  StyleBox["xList", "TI"]], "InlineFormula",ExpressionUUID->
  "d19bd542-6fab-ec4e-a501-c5d5bbc119d0"],
 ", ",
 Cell[BoxData[
  StyleBox["cmpx", "TI"]], "InlineFormula",ExpressionUUID->
  "456baeaa-65e5-e941-b842-c924a4263f09"],
 "] checks whether ",
 Cell[BoxData[
  StyleBox["cmpx", "TI"]], "InlineFormula",ExpressionUUID->
  "1247c74b-ba04-a847-a123-d58d6048f46a"],
 " is isomorphic to any complexes in ",
 Cell[BoxData[
  StyleBox["xList", "TI"]], "InlineFormula",ExpressionUUID->
  "a41ede69-4689-cf47-b5ae-aa74e66fd00a"],
 ", returning True after the first occurrence of isomorphism and False \
otherwise."
}], "Usage",
 CellChangeTimes->{{3.9708443803999176`*^9, 3.9708444345322704`*^9}, {
