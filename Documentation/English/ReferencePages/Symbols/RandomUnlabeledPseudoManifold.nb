Notebook[{

Cell[CellGroupData[{
Cell["RandomUnlabeledPseudoManifold", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b8ce71b9-9277-4ed6-b063-70b728a9c99b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomUnlabeledPseudoManifold",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/RandomUnlabeledPseudoManifold"], "[", 
   StyleBox[
    RowBox[{"{", 
     RowBox[{"p_Integer", ",", "q_Integer"}], "}"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"bfaca367-a01b-4b58-b5d7-3a0efc9e6d3a"],
 " generates a random unlabeled pseudo-manifold of purity ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "9cac642e-81e8-4284-83ce-3f95299d1c27"],
 " and facet-order ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",ExpressionUUID->
  "7f40f644-1143-4d39-b3a6-734d2c82fbf9"],
 ", returned as a pair {facets, pastingSites} where the pasting sites are the \
codimension-1 faces free to bind another facet."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The second element lists the boundary (codimension-1) faces available for \
gluing; AddRandomUnlabeledFacetToPseudoManifold consumes a pair in exactly \
this form.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

