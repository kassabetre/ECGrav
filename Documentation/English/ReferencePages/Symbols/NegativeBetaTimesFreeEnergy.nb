Cell[CellGroupData[{
Cell["NegativeBetaTimesFreeEnergy", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"44fe0792-2ca6-421a-b6e3-a46e4ae0e032"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NegativeBetaTimesFreeEnergy",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NegativeBetaTimesFreeEnergy"], "[", 
   StyleBox[
    RowBox[{
    "bf_Real", ",", " ", "minusBetaF_Association", ",", " ", 
     "energyMeasurements_Association"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"d7b4bcac-d44e-4fde-8471-88dac560e153"],
 " computes -\[Beta]F at inverse temperature ",
 Cell[BoxData[
  StyleBox["bf", "TI"]], "InlineFormula",ExpressionUUID->
  "5b4f096f-0dfd-428c-ad0b-eac80443c845"],
 " by reweighting the multi-histogram data ",
 Cell[BoxData[
  StyleBox["minusBetaF", "TI"]], "InlineFormula",ExpressionUUID->
  "af9c38e4-b0ff-4341-bc6c-63da1aa3a57c"],
 " and ",
 Cell[BoxData[
  StyleBox["energyMeasurements", "TI"]], "InlineFormula",ExpressionUUID->
  "0d21edf1-cfba-4ce4-a311-e76f723d57bc"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"87e3acbb-a310-45b8-bd39-b7d35cdf3876"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NegativeBetaTimesFreeEnergy",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NegativeBetaTimesFreeEnergy"], "[", 
   StyleBox[
    RowBox[{
    "betaFixed_Real", ",", " ", "targetExtField_Real", ",", " ", 
     "minusBetaF_Association", ",", " ", 
     "conjugateMeasurements_Association"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"6fd1d159-2a00-4741-9075-6cd4eb4f0d8e"],
 " instead extrapolates in an external field at fixed inverse temperature ",
 Cell[BoxData[
  StyleBox["betaFixed", "TI"]], "InlineFormula",ExpressionUUID->
  "93226354-cb0b-47e9-b528-b6984b30feef"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Interpolates/extrapolates the free energy to a target inverse temperature (or \
external field) from simulations at several values. The associations must \
share keys with equal-length lists.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

