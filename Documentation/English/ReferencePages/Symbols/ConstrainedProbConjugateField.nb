Cell[CellGroupData[{
Cell["ConstrainedProbConjugateField", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2ffd948b-e7b3-4c60-999c-b0a20ba1e480"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConstrainedProbConjugateField",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/ConstrainedProbConjugateField"], "[", 
   StyleBox[
    RowBox[{
    "betaFixed_Real", ",", " ", "targetExtField_List", ",", " ", 
     "minusBetaF_Association", ",", " ", 
     "conjugateExtFieldMeasurements_Association"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"4f73ec74-f49d-4a86-8d4a-e4df99d4b8b2"],
 " gives the probability density of the conjugate field (e.g. magnetization) \
at fixed inverse temperature ",
 Cell[BoxData[
  StyleBox["betaFixed", "TI"]], "InlineFormula",ExpressionUUID->
  "08629a40-3cb9-469d-86c9-f7c2bdcb77df"],
 " and external-field values ",
 Cell[BoxData[
  StyleBox["targetExtField", "TI"]], "InlineFormula",ExpressionUUID->
  "5a55f5f5-5259-452b-856d-0a7ef1aa31bd"],
 ", for Landau-free-energy analysis."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
targetExtField is a vector of external-field values. The result is a list \
containing a SmoothKernelDistribution of the conjugate field (together with \
plot ranges), which can be plotted against the conjugate field. The \
associations must share the same keys with equal-length measurement lists.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

