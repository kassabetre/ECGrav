Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ae4689b4-d1b1-9245-8a89-a9b44fca80b1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DGraphBoundary",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/DGraphBoundary"], "[", 
   StyleBox["g_Graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c4bb06d3-a412-a248-9930-c46806b1054f"],
 "\[LineSeparator]outputs the induced subgraph which is the boundary of the \
graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "f26def63-a4b4-bb45-a69f-cb36bd2082ad"],
 ". The boundary of a geometric graph is the induced subgraph over boundary \
nodes, i.e. those vertices whose unit spheres are contractible, or paths."
}], "Usage",
 CellChangeTimes->{
