Cell[CellGroupData[{
Cell["ExactExpectationValue", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"609c3a3e-350e-43de-8273-827d286c04f6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExactExpectationValue",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/ExactExpectationValue"], "[", 
   StyleBox[
    RowBox[{
    "ensemble_List", ",", " ", "degenValues_List", ",", " ", "obsfunctions_", 
     ",", " ", "Hamiltonian_", ",", " ", "beta_"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"c94e0dc1-9ccb-4d7d-ad30-5a19ecdf6bdc"],
 " computes exact canonical-ensemble averages over the finite ",
 Cell[BoxData[
  StyleBox["ensemble", "TI"]], "InlineFormula",ExpressionUUID->
  "cfcd1fff-4280-4cf7-9c81-6a045fc0bcf6"],
 " of adjacency matrices. For each degeneracy-weight scheme in ",
 Cell[BoxData[
  StyleBox["degenValues", "TI"]], "InlineFormula",ExpressionUUID->
  "59a5d22c-1ce5-4e71-80d6-42a6bf80bf87"],
 " it returns the partition function, the free energy, and the expectation \
values of the observable functions ",
 Cell[BoxData[
  StyleBox["obsfunctions", "TI"]], "InlineFormula",ExpressionUUID->
  "25e59bcc-2d11-486f-a11d-e79c5182353f"],
 ", using Boltzmann weights from ",
 Cell[BoxData[
  StyleBox["Hamiltonian", "TI"]], "InlineFormula",ExpressionUUID->
  "8f568537-206c-4acb-b5df-ef87926a3fbb"],
 " at inverse temperature ",
 Cell[BoxData[
  StyleBox["beta", "TI"]], "InlineFormula",ExpressionUUID->
  "bef45918-77e5-4029-a0a3-0b3e2ecbc9a1"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The Hamiltonian must be a one-argument function of an adjacency matrix, so \
parametrize it (e.g. HIsing[#,1.,0.]&). A harmless Part::partd message may be \
emitted while the observable argument is matched (the result is correct).\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

