Notebook[{

Cell[CellGroupData[{
Cell["H2dCombManifold", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"eb406751-6b68-4714-8233-2a86105f23c3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["H2dCombManifold",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/H2dCombManifold"], "[", 
   StyleBox[
    RowBox[{"Am_List", ",", " ", "J_"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"813da127-8b12-4e63-91f0-472e256d4f25"],
 " gives an energy for the graph with adjacency matrix ",
 Cell[BoxData[
  StyleBox["Am", "TI"]], "InlineFormula",ExpressionUUID->
  "daa6b049-2f8b-45b8-8d8a-aa3df262871c"],
 " that vanishes on 2-dimensional combinatorial manifolds (surfaces \
homeomorphic to the sphere S\.b2 or disk B\.b2)."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The energy is minimized (zero) exactly on 2D combinatorial manifolds. \
delH2dCombManifold gives its change under a single edge toggle.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

