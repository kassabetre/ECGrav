Notebook[{

Cell[CellGroupData[{
Cell["CombinatorialSphereQ", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3ee4e59e-506d-4f31-9d77-0f58653395c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CombinatorialSphereQ",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/CombinatorialSphereQ"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e01d6c83-6e26-463e-bad4-53fb1000bf84"],
 " gives True if the complex ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "b82b7e16-a184-4183-bc1d-436eed9366ff"],
 " is a combinatorial sphere, and False otherwise."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
A combinatorial sphere is a combinatorial manifold PL-homeomorphic to a \
standard sphere; the boundary of a simplex is the simplest example. Note: the \
current test can return True for some non-spherical closed surfaces, so \
corroborate with an independent invariant (e.g. EulerChi) when it matters.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

