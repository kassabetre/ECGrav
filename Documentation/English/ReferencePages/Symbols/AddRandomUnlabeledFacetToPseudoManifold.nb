Notebook[{

Cell[CellGroupData[{
Cell["AddRandomUnlabeledFacetToPseudoManifold", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e7a3005f-d197-4dca-aeea-7dd85b38650d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddRandomUnlabeledFacetToPseudoManifold",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/AddRandomUnlabeledFacetToPseudoManifold"], 
   "[", 
   StyleBox[
    RowBox[{"facetsLst_List", ",", " ", "apastingSites_List"}], "TI"], "]"}]],
   "InlineFormula",ExpressionUUID->"58cad14b-0f3a-41ee-a18a-c52d2c7f00ff"],
 " adds a random facet to the pseudo-manifold ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "9f0ed9b0-b6ce-4911-9a6d-8060ffb73e96"],
 " at one of the pasting sites ",
 Cell[BoxData[
  StyleBox["apastingSites", "TI"]], "InlineFormula",ExpressionUUID->
  "a35783f6-2884-4e85-8dd2-62dbf2df38e5"],
 " (codimension-1 faces free to bind), chosen up to the automorphism group of \
the complex, and returns the enlarged {facets, pastingSites} pair."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
RandomUnlabeledPseudoManifold returns a complex together with its pasting \
sites in exactly the {facets, pastingSites} form this function expects.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

