Cell["\<\
Start from a random pseudo-manifold, delivered as a {facets, pastingSites} \
pair:\
\>", "ExampleText",
 CellID->958087842,ExpressionUUID->"41144655-1647-45a4-9985-2cca9fe286d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"seed", "=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "5", "]"}], ";", 
    RowBox[{"RandomUnlabeledPseudoManifold", "[", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], "]"}]}], ")"}]}]], "Input",
