Notebook[{

Cell[CellGroupData[{
Cell["HIsing", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"628204df-d313-4c9a-a72c-655f2277f2d8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HIsing",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/HIsing"], "[", 
   StyleBox[
    RowBox[{"Am_List", ",", " ", "J_", ",", " ", "L_"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"b7a8d4b7-2487-45f4-adda-0172cc403433"],
 " gives the Ising-type graph energy ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",ExpressionUUID->
  "caf20607-41c9-4dd7-b541-24073680a85c"],
 "/2 \[Sum] (A\.b2)",
 Cell[BoxData[
  SubscriptBox["", "ij"]], "InlineFormula",ExpressionUUID->
  "73df9d13-ff56-4f1b-a4dd-93bff042c769"],
 " + ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",ExpressionUUID->
  "e6fca24f-b327-478f-bcad-9199b45cfc5c"],
 "/2 \[Sum] A",
 Cell[BoxData[
  SubscriptBox["", "ij"]], "InlineFormula",ExpressionUUID->
  "194463c9-9304-45ae-82ac-e89fee771431"],
 " of the graph with adjacency matrix ",
 Cell[BoxData[
  StyleBox["Am", "TI"]], "InlineFormula",ExpressionUUID->
  "39f7a642-d245-4315-af68-6a9460235188"],
 ", coupling ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",ExpressionUUID->
  "ce124856-80a7-49ea-8bd1-e8020e9e600b"],
 ", and field-like term ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",ExpressionUUID->
  "a77cff42-2a82-4ce6-8078-707d4af0772f"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The coupling J and field L must be given as real numbers. delHIsing gives the \
change in HIsing under a single edge toggle, as used by the Metropolis \
sampler.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

