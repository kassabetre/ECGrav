Notebook[{

Cell[CellGroupData[{
Cell["InternalEnergy", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f9b6ec88-8a27-4ffc-9947-545e219c9abd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["InternalEnergy",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/InternalEnergy"], "[", 
   StyleBox[
    RowBox[{
    "bf_", ",", " ", "minusBetaF_Association", ",", " ", 
     "energyMeasurements_Association"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"8d494c6e-1ba8-4f29-80a4-b1e73ba55698"],
 " computes the internal energy U at inverse temperature ",
 Cell[BoxData[
  StyleBox["bf", "TI"]], "InlineFormula",ExpressionUUID->
  "40775710-1fa9-4897-88d4-5f9f32179859"],
 ", using the multi-histogram data: ",
 Cell[BoxData[
  StyleBox["minusBetaF", "TI"]], "InlineFormula",ExpressionUUID->
  "17b9c3da-b6e3-4428-ae5f-5af209ab024d"],
 " maps each simulated inverse temperature to its -\[Beta]F value, and ",
 Cell[BoxData[
  StyleBox["energyMeasurements", "TI"]], "InlineFormula",ExpressionUUID->
  "f7016fb2-e4c8-40fa-8818-6ca0bd63de0b"],
 " maps each to its list of measured energies."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Part of the multi-histogram (Ferrenberg-Swendsen) reweighting family: \
combines runs at several temperatures to interpolate thermodynamic \
quantities. The two associations must share the same set of beta keys with \
equal-length measurement lists.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

