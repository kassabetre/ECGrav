Notebook[{

Cell[CellGroupData[{
Cell["DSphereQ", "ObjectName",
 CellID->596350048,ExpressionUUID->"2e991c68-0a35-d841-94e4-fb1b02edd88a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d4622901-ce7e-3146-bd36-d45906f5d9fb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DSphereQ",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/DSphereQ"], "[", 
   StyleBox["g_Graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "544a3832-a81e-714b-a8e6-faaa6d731261"],
 "\[LineSeparator]outputs true if the graph ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], " "}]], "InlineFormula",ExpressionUUID->
  "202f35b8-d22c-9c46-969f-3b071f788be9"],
 "is a combinatorial manifold homeomorphic to a sphere."
}], "Usage",
 CellChangeTimes->{{3.9720493519391136`*^9, 3.9720493694409695`*^9}},
 CellID->96515329,ExpressionUUID->"04f90686-8fa4-bb43-8176-24412c84128d"],

Cell["\<\
DSphereQ is True when the clique complex of the graph is a closed d-graph \
(see ClosedDGraphQ) that additionally has the Euler characteristic of a \
sphere, chi = 1 + (-1)^d. For surfaces this is exact: the octahedron graph is \
a 2-sphere and returns True, while a graph whose clique complex is a torus \
returns False. In dimension three and above the Euler-characteristic \
condition is necessary but not sufficient.\
\>", "Notes",
 CellID->828728722,ExpressionUUID->"c3f7bdad-65a5-b244-9fce-78c12cf32195"]
}, Open  ]],

