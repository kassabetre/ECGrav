Cell["A vertex labeled graph, g:", "ExampleText",
 CellChangeTimes->{3.97079022763838*^9},
 CellID->22597451,ExpressionUUID->"3bd319ce-c7e8-9f4f-8834-e1c5b8a5e72e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "\[UndirectedEdge]", "2"}], ",", 
      RowBox[{"2", "\[UndirectedEdge]", "3"}], ",", 
      RowBox[{"1", "\[UndirectedEdge]", "4"}], ",", 
      RowBox[{"3", "\[UndirectedEdge]", "4"}]}], "}"}], ",", 
    RowBox[{"VertexLabels", "\[Rule]", "\"\<Name\>\""}], ",", 
    RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}]], "Input",
