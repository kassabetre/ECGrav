Cell[CellGroupData[{

Cell["\<\
g = Graph[{1\[UndirectedEdge]2,2\[UndirectedEdge]3,3\[UndirectedEdge]4,1\
\[UndirectedEdge]3},VertexLabels\[Rule]\"Name\",ImageSize->Medium]\
\>", "Input",
