Cell[CellGroupData[{
Cell["ClosedDGraphQ", "ObjectName",
 CellID->302459279,ExpressionUUID->"9d2f5112-b2e5-4574-9367-20ade00f30de"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"64b8a0d9-07c6-4ff1-857d-77155af7cfe8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ClosedDGraphQ",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/ClosedDGraphQ"], "[", 
   StyleBox["g_Graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f36aff86-2117-47c8-805f-81fe04cdbd18"],
 "\[LineSeparator]outputs true if the graph ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], " "}]], "InlineFormula",ExpressionUUID->
  "36b01f47-b8c0-418f-b18f-cca51678c42f"],
 "is a combinatorial manifold without boundary (a closed d-graph)."
}], "Usage",
 CellChangeTimes->{{3.9720493519391136`*^9, 3.9720493694409695`*^9}},
 CellID->251182472,ExpressionUUID->"f5e2067a-32cf-4e2b-bf7e-9db52f220f38"],

Cell["\<\
A closed d-graph is the graph analogue of a closed combinatorial manifold: \
the unit sphere of every vertex is recursively a closed d-graph, bottoming \
out at a cycle (the 1-sphere). The clique complex may be any closed surface, \
so a sphere, torus, or Klein bottle all return True. Use DSphereQ to test \
specifically whether the clique complex is a sphere.\
\>", "Notes",
 CellID->551214583,ExpressionUUID->"053e15fd-f584-4f31-9f54-5059cb0aefa3"]
}, Open  ]],

