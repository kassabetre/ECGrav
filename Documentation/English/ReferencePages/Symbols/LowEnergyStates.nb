Cell[CellGroupData[{
Cell["LowEnergyStates", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bd7122eb-2bf1-4c11-8c00-c4c4587ecd21"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LowEnergyStates",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/LowEnergyStates"], "[", 
   StyleBox[
    RowBox[{"states_List", ",", " ", "H_", ",", " ", "klevel_Integer"}], "TI"],
    "]"}]], "InlineFormula",ExpressionUUID->
  "49298759-1564-445f-b15d-2659d73ef43a"],
 " computes the energies of the adjacency matrices in ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",ExpressionUUID->
  "b52bd3da-50dc-4d73-bff5-61bb8872ae15"],
 " under the Hamiltonian ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",ExpressionUUID->
  "019602a7-ae08-454e-8e71-c50973e75b73"],
 " and returns an ordered association whose keys are the ",
 Cell[BoxData[
  StyleBox["klevel", "TI"]], "InlineFormula",ExpressionUUID->
  "3cc31f26-958a-4f76-9b49-4c7266d7d5df"],
 " lowest energies and whose values are the states attaining them."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The Hamiltonian is a one-argument pure function of an adjacency matrix, e.g. \
HIsing[#,-1.,0.]&. Deterministic: it simply ranks a supplied list of states.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

