Notebook[{

Cell[CellGroupData[{
Cell["GradDescent", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2f455dcb-b261-434a-8d3c-46d37810adaf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GradDescent",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GradDescent"], "[", 
   StyleBox[
    RowBox[{"seedAmat_", ",", " ", "delH_", ",", " ", "cutoff_"}], "TI"], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "7af949c4-e21b-4809-9f34-c4981dd1069b"],
 " runs greedy gradient descent from the seed adjacency matrix ",
 Cell[BoxData[
  StyleBox["seedAmat", "TI"]], "InlineFormula",ExpressionUUID->
  "016767c5-e7e4-4b23-b013-6e6d964eeb92"],
 ", at each step flipping the edge that most decreases the energy (via the \
delta-energy formula ",
 Cell[BoxData[
  StyleBox["delH", "TI"]], "InlineFormula",ExpressionUUID->
  "5f95b146-8714-4475-9b24-d50879c74018"],
 "), for up to ",
 Cell[BoxData[
  StyleBox["cutoff", "TI"]], "InlineFormula",ExpressionUUID->
  "af85bac1-d052-4f7f-bf6c-77385ef373ca"],
 " sweeps. It returns the resulting adjacency matrix."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
delH is passed as an inert head with parameters, e.g. dH[-1.,0.] where \
dH[a_,j_,l_,i_,k_]:=delHIsing[a,j,l,i,k]. Greedy descent converges to a local \
energy minimum.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

