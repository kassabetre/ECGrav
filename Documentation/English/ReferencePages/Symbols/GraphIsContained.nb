Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dbbef63a-d5f6-c445-8743-216b2b106570"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphIsContained",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphIsContained"], "[", 
   RowBox[{
    StyleBox["glist_List", "TI"], ",", 
    StyleBox["g_Graph", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0afcf2a5-9477-0846-87a7-3968b25b4aab"],
 "\[LineSeparator]checks whether or not the graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "ccd6626d-284c-d04a-9f26-e81d1f83ccf8"],
 " is isomorphic to any graphs in ",
 Cell[BoxData[
  StyleBox["glist", "TI"]], "InlineFormula",ExpressionUUID->
  "d90d023a-f2ae-f04a-b933-cd281f804d6d"],
 ", returning True after the first occurrence of isomorphism and False \
otherwise. The elements of ",
 Cell[BoxData[
  StyleBox["glist", "TI"]], "InlineFormula",ExpressionUUID->
  "a59ca1ef-a74e-1548-9ea0-3f847db1e360"],
 " must be exclusively graphs.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ac801b1b-5464-8440-82f3-e34b74eee07d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphIsContained",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/GraphIsContained"], "[", 
   RowBox[{
    StyleBox["AmatList_List", "TI"], ",", 
    StyleBox["Amat_Graph", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1f3aca16-931b-3b4e-b1e0-4c00d28b91bc"],
 "\[LineSeparator]checks whether or not the graph represented by adjacency \
matrix ",
 Cell[BoxData[
  StyleBox["Amat", "TI"]], "InlineFormula",ExpressionUUID->
  "327d2936-e32b-ed4d-81a5-085f74b7b57f"],
 " is isomorphic to any graphs in  ",
 Cell[BoxData[
  StyleBox["AmatList", "TI"]], "InlineFormula",ExpressionUUID->
  "5f11a2e5-2df6-1741-86a8-2de5a899b91a"],
 ", returning True after the first occurrence of isomorphism and False \
otherwise. The elements of ",
 Cell[BoxData[
  StyleBox["AmatList", "TI"]], "InlineFormula",ExpressionUUID->
  "299406db-0902-b041-bf59-4fa27c228259"],
 " must be exclusively graph adjacency matrices."
}], "Usage",
