  StyleBox["cList", "TI"]], "InlineFormula",ExpressionUUID->
  "86753610-e5cf-e64d-ab3f-1ec52db919a3"],
 ", ",
 Cell[BoxData[
  StyleBox["cmpx", "TI"]], "InlineFormula",ExpressionUUID->
  "c12d44b6-7aca-db4f-bdda-a4e1442d533e"],
 "] checks whether ",
 Cell[BoxData[
  StyleBox["cmpx", "TI"]], "InlineFormula",ExpressionUUID->
  "55e356da-1460-f449-b4c2-86b46255c3c2"],
 " is isomorphic to any complexes in ",
 Cell[BoxData[
  StyleBox["cList", "TI"]], "InlineFormula",ExpressionUUID->
  "485473b0-341e-784e-86c7-0fb6096db7ad"],
 ", returning True after the first occurrence of isomorphism and False \
otherwise."
}], "Usage",
