  StyleBox["cList_List", "TI"]], "InlineFormula",ExpressionUUID->
  "a255bdfa-3237-604b-aeda-e2c97e307839"],
 ", ",
 Cell[BoxData[
  StyleBox["cmpx_List", "TI"]], "InlineFormula",ExpressionUUID->
  "c206ce32-fe67-8d40-a964-f165681ac260"],
 "]\[LineSeparator]Given a list of clique complexes (each given as a list of \
maximal cliques) ",
 Cell[BoxData[
  StyleBox["cList", "TI"]], "InlineFormula",ExpressionUUID->
  "1728e05f-8d9d-2d45-80f1-2134f73b6adc"],
