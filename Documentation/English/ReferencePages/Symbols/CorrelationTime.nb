Notebook[{

Cell[CellGroupData[{
Cell["CorrelationTime", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7baf4455-51de-4fbd-a8a1-cffe70ed9dae"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CorrelationTime",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/CorrelationTime"], "[", 
   StyleBox[
    RowBox[{"t_Integer", ",", " ", "tbl_List"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"439d4955-3025-408e-9091-b4f1f76d80ab"],
 " computes the autocorrelation at lag ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "ea4fa483-1ca4-4d90-aa9d-b883d409886a"],
 " of the series of measurements ",
 Cell[BoxData[
  StyleBox["tbl", "TI"]], "InlineFormula",ExpressionUUID->
  "e541af1f-0a14-4ca5-bb97-b67ad3fa54b6"],
 " (e.g. energy or magnetization from a Monte Carlo run)."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Autocorrelation quantifies how quickly successive Monte Carlo measurements \
decorrelate. EmpCorrelationTime gives an empirical variant; \
GraphComputeCorrelationTime estimates it during a simulation.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

