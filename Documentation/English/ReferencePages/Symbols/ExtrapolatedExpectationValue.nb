 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c1879dee-983a-4bc9-853b-fc0eabf56e75"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExtrapolatedExpectationValue",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/ExtrapolatedExpectationValue"], "[", 
   StyleBox[
    RowBox[{
    "bf_Real", ",", " ", "minusBetaF_Association", ",", " ", 
     "energyMeasurements_Association", ",", " ", 
     "observableValues_Association"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"c60d4708-7d4c-4ad2-813f-808dfbc95099"],
 " extrapolates the expectation of an observable to inverse temperature ",
 Cell[BoxData[
  StyleBox["bf", "TI"]], "InlineFormula",ExpressionUUID->
  "cf13075e-1a7e-446c-8cfd-93e656b45535"],
 " by multi-histogram reweighting of the energy data and the measured \
observable values ",
 Cell[BoxData[
  StyleBox["observableValues", "TI"]], "InlineFormula",ExpressionUUID->
  "8270457f-9aa2-4751-a7d1-78d731036307"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
An overload extrapolates in an external field at fixed inverse temperature. \
All associations must share the same keys with equal-length measurement lists.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

