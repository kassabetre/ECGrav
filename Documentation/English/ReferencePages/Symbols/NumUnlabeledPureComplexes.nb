Cell["\<\
Count the fully unlabeled pure complexes with purity 3, facet order 4 and 6 \
vertices:\
\>", "ExampleText",
 CellID->205917214,ExpressionUUID->"c8eb8a36-801e-490d-9a39-e743a1f3a030"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NumUnlabeledPureComplexes", "[", 
  RowBox[{"3", ",", "4", ",", "6"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->732589575,ExpressionUUID->"b6caf455-38d2-4c23-8498-419820dbea0f"],

Cell[BoxData["15"], "Output",
 CellLabel->"Out[1]=",
 CellID->939064553,ExpressionUUID->"daa4a613-3408-4472-9c0e-24dbaabf0d00"]
}, Open  ]],

Cell["\<\
The same complexes counted three ways: with the vertices labeled, with the \
facets labeled, and with neither. Each isomorphism class splits into several \
labeled complexes, so the unlabeled count is the smallest of the three:\
\>", "ExampleText",
 CellID->796484779,ExpressionUUID->"e42af5aa-9406-43cf-bfb9-2ba6f79e76be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"NumVertexLabeledPureComplexes", "[", 
    RowBox[{"2", ",", "3", ",", "4"}], "]"}], ",", 
   RowBox[{"NumFacetLabeledPureComplexes", "[", 
    RowBox[{"2", ",", "3", ",", "4"}], "]"}], ",", 
   RowBox[{"NumUnlabeledPureComplexes", "[", 
    RowBox[{"2", ",", "3", ",", "4"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->101184347,ExpressionUUID->"05b7584e-0aa1-47db-817d-877a8270af55"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", "4", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->599330544,ExpressionUUID->"f761ae9a-e528-4151-a960-e81d89d88eec"]
}, Open  ]]
}, Open  ]],

