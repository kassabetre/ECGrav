Notebook[{

Cell[CellGroupData[{
Cell["NumUnlabeledPureComplexes", "ObjectName",
 CellID->754232648,ExpressionUUID->"a6fa5887-e82b-4ef6-9c40-f9cb68bae3d9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["NumUnlabeledPureComplexes",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NumUnlabeledPureComplexes"], "[", 
   RowBox[{
    StyleBox["p_Integer", "TI"], ",", 
    StyleBox["M_Integer", "TI"], ",", 
    StyleBox["n_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "273c9fd2-5076-4959-9247-cd8a0e44eb56"],
 "\ngives the number of fully unlabeled pure simplicial complexes of purity \
",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "ccdf8ca6-7712-4b7b-abf8-ab2676fb0b36"],
 ", facet order ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "0bfed1a4-1870-47b8-8821-a7fe389086f4"],
 ", and number of vertices ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "ae6d80d1-8231-4457-b388-7b1d3c0e8703"],
 ": ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "5abdabf1-d48f-4e51-a667-ebe91334c396"],
 " pairwise distinct ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "b63d4528-fdb6-43fa-b533-8bab0b3f9e59"],
 "-subsets of an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "85494db4-8f7b-4e82-b29c-2938ee0fba09"],
 "-element vertex set whose union is the whole set, counted up to relabeling \
the vertices and permuting the facets.\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NumUnlabeledPureComplexes",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NumUnlabeledPureComplexes"], "[", 
   RowBox[{
    StyleBox["p_Integer", "TI"], ",", 
    StyleBox["M_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1e25394f-ebc0-41d9-9a3c-be584d94c3be"],
 "\ngives the same count summed over the vertex count ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "0bfd0f4c-9a1d-46ec-9d35-42f8f2d20e44"],
 "."
}], "Usage",
 CellID->827961916,ExpressionUUID->"2f425557-9465-4e46-92e9-87379aa80f9a"],

Cell[TextData[{
 "These are the isomorphism classes of pure complexes, so this is the count \
that ",
 Cell[BoxData[
  ButtonBox["NumVertexLabeledPureComplexes",
   BaseStyle->"Link",
   ButtonData->"paclet:ECGrav/ref/NumVertexLabeledPureComplexes"]], 
  "InlineSeeAlsoFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "bcc7f916-150e-497f-97fe-65b4ba4ead7d"],
 " and ",
 Cell[BoxData[
  ButtonBox["NumFacetLabeledPureComplexes",
   BaseStyle->"Link",
   ButtonData->"paclet:ECGrav/ref/NumFacetLabeledPureComplexes"]], 
  "InlineSeeAlsoFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "25e04726-71fa-4a91-b19c-cd50f0a778e0"],
 " each refine: every isomorphism class carries at least one vertex-labeled \
and at least one facet-labeled complex, and distinct classes carry disjoint \
sets of them, so the count here never exceeds either. The count is zero \
unless ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "364a6413-f2e8-4c54-a277-3d3e7fd8af32"],
 " <= ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "d1ad89fd-1325-4860-958c-9b076270faaf"],
 " <= ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "76121c2c-3913-4a47-b67d-f7533c50cda2"],
 " ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "8a6ae0ea-b6f4-4f45-b0c1-a14d1c190ba5"],
 ", and zero when there are fewer than ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "b3e4e700-2b10-4bfb-b772-ea3dfe077ab4"],
 " distinct ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "dc3ce97a-89de-457d-9d1f-5de1f2a88131"],
 "-subsets to draw the facets from."
}], "Notes",
 CellID->742322137,ExpressionUUID->"316125c3-2eb1-4ab9-99c8-2a1802822fca"],

Cell[TextData[{
 "It is computed by Burnside's lemma over the vertex permutations, and so \
sums over the cycle types of the symmetric group on ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "21f3da8c-1ba6-44ab-8fab-74c80c83d630"],
 " letters: the cost grows like the number of integer partitions of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "21e7085a-f110-46fd-b7f5-3b1bf5b945da"],
 ", which makes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "ba7a52ef-3691-4c5e-8a74-47aa53498b80"],
 " -- rather than ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "b686ba49-5b01-4ca6-9270-6a3d1ce837b8"],
 " or ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "edea5a33-8ca1-4b34-8d63-44fec5c1554a"],
 " -- the limiting argument. Results are memoized for the session."
}], "Notes",
 CellID->492329245,ExpressionUUID->"9a88a0c5-f70f-4db3-86fe-0643cfb559b3"]
}, Open  ]],

