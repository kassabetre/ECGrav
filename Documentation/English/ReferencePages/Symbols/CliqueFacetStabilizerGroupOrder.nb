Cell[CellGroupData[{
Cell["CliqueFacetStabilizerGroupOrder", "ObjectName",
 CellID->118753101,ExpressionUUID->"3b82747d-a548-ed49-aa4a-009f3308bdfc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3f9f9920-c387-5647-855e-e79d2f5633d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CliqueFacetStabilizerGroupOrder",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/CliqueFacetStabilizerGroupOrder"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1792fa3e-8e14-8245-863f-9afad7de32f7"],
 "\[LineSeparator]returns the order of the facet stabilizer group of the \
clique complex given as a list ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "5ae1a519-19d8-ae45-8765-07fe00e47ea5"],
 " of maximal cliques. It does not check whether or not the complex is a \
clique complex, it assumes it is."
}], "Usage",
 CellChangeTimes->{{3.9744817754031696`*^9, 3.9744818098144493`*^9}},
 CellID->4193443,ExpressionUUID->"77e5eb1b-bb72-114f-942e-52fe7afc91c7"],

