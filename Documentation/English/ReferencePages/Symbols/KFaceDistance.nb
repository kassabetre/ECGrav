Notebook[{

Cell[CellGroupData[{
Cell["KFaceDistance", "ObjectName",
 CellID->160445533,ExpressionUUID->"608322b6-9e43-8f4a-ad32-e2ab307c0e55"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b11a67ce-21f7-0d4f-bb82-20cc99cd6fe3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["KFaceDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/KFaceDistance"], "[", 
   RowBox[{
    StyleBox["facetsLst_List", "TI"], ",", 
    SubscriptBox[
     StyleBox["face", "TI"], 
     StyleBox[
      RowBox[{"1", "_List"}], "TI"]], ",", 
    SubscriptBox[
     StyleBox["face", "TI"], 
     StyleBox[
      RowBox[{"2", "_List"}], "TI"]]}], "]"}]], "InlineFormula",
  ExpressionUUID->"ba9c2957-ed5a-5f4e-aac2-97f972f558e6"],
 "\[LineSeparator]Given a simplicial complex as a list of facets ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "6307f63e-2c5d-f44f-9ceb-73d74ff11c43"],
 " and two equal cardinality faces of ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "f2d5c488-975a-8241-a03f-5e744c79e168"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["face", "TI"], 
   StyleBox["1", "TR"]]], "InlineFormula",ExpressionUUID->
  "d61bac90-f93a-ab4e-8143-d56f0164f1c4"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["face", "TI"], 
   StyleBox["2", "TR"]]], "InlineFormula",ExpressionUUID->
  "6b07cdb0-4581-1549-b937-e012cdef1d11"],
 " of cardinality k, it computes the minimum k-face distance between them \
where the path steps on only (k+1)-dimensional faces joined along \
k-dimensional subfaces. It uses the built in Mathematica GraphDistance \
function on a graph constructed such that the vertices are all k-faces and \
edges between them are 1 if two faces are contained in a bigger face and 0 \
otherwise."
}], "Usage",
 CellChangeTimes->{
  3.9708711852390423`*^9, {3.971882382258896*^9, 3.9718824305578575`*^9}, {
   3.9718824675087757`*^9, 3.971882493275017*^9}, {3.971882542841793*^9, 
   3.9718825649652233`*^9}, 3.971900289572527*^9, {3.9719125285404167`*^9, 
   3.9719125297861767`*^9}},
 CellID->173117722,ExpressionUUID->"2f7db9c0-b2c5-a641-b5fb-e1bc1b34a50f"],

Cell["XXXX", "Notes",
 CellID->7295122,ExpressionUUID->"7ec6bd1d-4abc-5343-b629-fb5d61f35b07"]
}, Open  ]],

