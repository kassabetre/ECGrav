Notebook[{

Cell[CellGroupData[{
Cell["RandomPureSimplicialComplexMCMCSweep", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f086e107-5789-4f61-acf2-54f9bf0b062d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomPureSimplicialComplexMCMCSweep",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/RandomPureSimplicialComplexMCMCSweep"], "[", 
   StyleBox[
    RowBox[{
    "seedComplex_List", ",", " ", "labelingChoise_Integer", ",", " ", 
     "NN_Integer"}], "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "08f5b788-3a34-48ca-9eea-c5333bf15959"],
 " performs ",
 Cell[BoxData[
  StyleBox["NN", "TI"]], "InlineFormula",ExpressionUUID->
  "3557277e-e14c-46a0-b410-88943f9ff956"],
 " Markov-chain Monte Carlo sweeps (a sweep is purity\[Times]facetOrder \
steps) on ",
 Cell[BoxData[
  StyleBox["seedComplex", "TI"]], "InlineFormula",ExpressionUUID->
  "cc317a4b-46d9-4021-9e3b-a73436a271fa"],
 ", and returns an association with the resulting complex, its vertex count, \
weight, and energy. ",
 Cell[BoxData[
  StyleBox["labelingChoise", "TI"]], "InlineFormula",ExpressionUUID->
  "ceb19bba-fcdd-4481-8c66-4f8bfba695ee"],
 " is 0, 1, or 2 for vertex-labeled, facet-labeled, or unlabeled. An overload \
takes a Boolean HoldNumVerticesFixed before ",
 Cell[BoxData[
  StyleBox["labelingChoise", "TI"]], "InlineFormula",ExpressionUUID->
  "d3c987b1-c3ce-41dd-8a15-80991c242698"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The Metropolis moves add or remove facets; with HoldNumVerticesFixed \[Rule] \
True the total vertex count is held constant. Results are random; seed with \
SeedRandom for reproducibility.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

