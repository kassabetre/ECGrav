Cell["\<\
Run three unlabeled MCMC sweeps starting from the tetrahedron; the result is \
an association describing the new state:\
\>", "ExampleText",
 CellID->713634332,ExpressionUUID->"f94521de-f420-4b07-be82-92013fada770"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "1", "]"}], ";", 
   RowBox[{"RandomPureSimplicialComplexMCMCSweep", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "}"}], ",", "2", ",", 
     "3"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->850191475,ExpressionUUID->"dc8d96f5-ef80-4d88-8ee5-0423541fb3ea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"complex\"\>", ",", "\<\"vertexCount\"\>", 
   ",", "\<\"weight\"\>", ",", "\<\"energy\"\>"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->196134238,ExpressionUUID->"28d1ec8a-f5f2-4b94-b2c0-9cfcc9ef93b1"]
}, Open  ]],

Cell["Extract the resulting complex:", "ExampleText",
