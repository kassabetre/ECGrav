Notebook[{

Cell[CellGroupData[{
Cell["OrientableCombinatorialManifoldQ", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c8f6fbe7-9d3d-4b6b-a1b7-091f61e15728"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["OrientableCombinatorialManifoldQ",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/OrientableCombinatorialManifoldQ"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "468e9635-b924-40ff-8861-b772363fda92"],
 " gives True if the complex ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "d25e4401-1af9-4163-84ef-80da227d3a9d"],
 ", assumed to be a pseudo combinatorial manifold, is orientable, and False \
otherwise."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Orientability is tested by trying to orient the facets consistently across \
shared codimension-1 faces. The octahedron is orientable; the \
M\[ODoubleDot]bius strip and Klein bottle are not.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

