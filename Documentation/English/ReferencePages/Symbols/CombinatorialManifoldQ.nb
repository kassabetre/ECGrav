Cell["\<\
The octahedron is a closed surface, hence a combinatorial manifold:\
\>", "ExampleText",
 CellID->767993048,ExpressionUUID->"3503da5e-d92a-44b5-8f47-8d9ec56f67e3"],

Cell[CellGroupData[{

