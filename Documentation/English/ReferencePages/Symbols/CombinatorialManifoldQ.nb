Notebook[{

Cell[CellGroupData[{
Cell["CombinatorialManifoldQ", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da8074cb-27d7-489e-9672-6f08afc54cc8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CombinatorialManifoldQ",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/CombinatorialManifoldQ"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "83ca177a-c2db-4a8b-968b-faec97ff7e78"],
 " gives True if the complex ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "0bd8879a-f640-49d2-991f-85fc8f0c1b94"],
 " is a combinatorial manifold, and False otherwise."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
In a combinatorial manifold the link of every vertex is a combinatorial \
sphere (or ball at the boundary). Closed surfaces such as the octahedron \
qualify; a pinch point where facets meet at a single vertex does not.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

