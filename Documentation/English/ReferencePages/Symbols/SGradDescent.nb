Notebook[{

Cell[CellGroupData[{
Cell["SGradDescent", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e387a08-f8b5-4682-a032-fcbc6688852c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SGradDescent",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/SGradDescent"], "[", 
   StyleBox[
    RowBox[{
    "seedAmat_", ",", " ", "H_", ",", " ", "delH_", ",", " ", "beta_", ",", 
     " ", "NN_"}], "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c6caca1e-0035-4e9c-829c-7fe244ec55fe"],
 " runs stochastic gradient descent with a softmax proposal at inverse \
temperature ",
 Cell[BoxData[
  StyleBox["beta", "TI"]], "InlineFormula",ExpressionUUID->
  "19ca6844-3031-4ddc-ab4d-b2699e16ffd6"],
 " from the seed adjacency matrix ",
 Cell[BoxData[
  StyleBox["seedAmat", "TI"]], "InlineFormula",ExpressionUUID->
  "b151d3ea-f63e-43ed-9280-f7649b6cb517"],
 " for ",
 Cell[BoxData[
  StyleBox["NN", "TI"]], "InlineFormula",ExpressionUUID->
  "949a4df1-d6fb-464d-ae40-0272baf746a3"],
 " sweeps."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Here the Hamiltonian H and the delta-energy delH are one-argument / \
three-argument pure functions, e.g. HIsing[#,-1.,0.]& and \
delHIsing[#1,-1.,0.,#2,#3]&. Returns an association {minE, minEstates, \
LastState}. Results are stochastic.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

