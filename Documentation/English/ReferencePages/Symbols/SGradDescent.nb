Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initialize", " ", "inputs"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nn", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"sdAm", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", "nn", "}"}], ",", 
      RowBox[{"{", "nn", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", "am_List", "]"}], ":=", 
     RowBox[{"HIsing", "[", 
      RowBox[{"am", ",", 
       RowBox[{"-", "1.0"}], ",", "0.0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH", "[", 
      RowBox[{"am_List", ",", "i_Integer", ",", "j_Integer"}], "]"}], ":=", 
     RowBox[{"delHIsing", "[", 
      RowBox[{"am", ",", 
       RowBox[{"-", "1.0"}], ",", "0.0", ",", "i", ",", "j"}], "]"}]}], 
    ";"}]}]}]], "Input",
