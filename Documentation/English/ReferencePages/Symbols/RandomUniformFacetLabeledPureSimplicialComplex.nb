Notebook[{

Cell[CellGroupData[{
Cell["RandomUniformFacetLabeledPureSimplicialComplex", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5c0ed895-feee-4cc0-835c-bc75a4fe82fd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomUniformFacetLabeledPureSimplicialComplex",
    BaseStyle->"Link",
    ButtonData->
     "paclet:ECGrav/ref/RandomUniformFacetLabeledPureSimplicialComplex"], "[", 
   StyleBox[
    RowBox[{"{", 
     RowBox[{"p_Integer", ",", "q_Integer"}], "}"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"bb926288-527c-4b37-a832-b54414d6ba76"],
 " generates a uniformly random facet-labeled pure simplicial complex of \
purity ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "6bc6f23a-fe96-4586-8f65-f87522a32c45"],
 " and facet-order ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",ExpressionUUID->
  "be4ebdd9-7552-48cc-8623-a4b16274e2e7"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"02b34fd3-187c-4906-be4f-a57a0ac35f41"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomUniformFacetLabeledPureSimplicialComplex",
    BaseStyle->"Link",
    ButtonData->
     "paclet:ECGrav/ref/RandomUniformFacetLabeledPureSimplicialComplex"], "[", 
   StyleBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p_Integer", ",", "q_Integer"}], "}"}], ",", " ", 
     "numSamples_Integer"}], "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fa8e7137-0dd7-43ab-83b8-3db5219a8924"],
 " returns a list of ",
 Cell[BoxData[
  StyleBox["numSamples", "TI"]], "InlineFormula",ExpressionUUID->
  "29242a46-4e79-4243-ba41-efae558af327"],
 " such complexes; an optional vertex count ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "9d02e84b-0bcc-41c0-84ab-6d057ec4ac43"],
 " may be given as a third element of the first argument."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Sampling is uniform over facet-labeled complexes. Results are random; seed \
with SeedRandom for reproducibility.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

