Notebook[{

Cell[CellGroupData[{
Cell["NumVertexLabeledPureComplexes", "ObjectName",
 CellID->844653402,ExpressionUUID->"6ac0a5aa-1043-432d-80ba-9776c9503a89"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["NumVertexLabeledPureComplexes",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NumVertexLabeledPureComplexes"], "[", 
   RowBox[{
    StyleBox["p_Integer", "TI"], ",", 
    StyleBox["M_Integer", "TI"], ",", 
    StyleBox["n_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b338735a-4e0b-4d98-855e-88bd8d5fb5e5"],
 "\ngives the number of vertex labeled pure simplicial complexes of purity ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "d39e22ce-f0fd-469a-bbbf-22ee111dc19c"],
 ", facet order ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "9d84f4fa-451c-4023-b6aa-cdc646fb8a7c"],
 ", and number of vertices ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "6bc7a394-1107-4e80-b213-761e5bd94e36"],
 " \[LongDash] the number of ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "3d723f1c-cb25-47e7-8fa0-0113a35a89c4"],
 "-element sets of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "276a08b3-4b09-42b7-86a7-4ec626f37f09"],
 "-subsets of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "798cad38-20f2-4d20-a7cd-966a273ad5bd"],
 " labeled vertices whose union is all of them.\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NumVertexLabeledPureComplexes",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NumVertexLabeledPureComplexes"], "[", 
   RowBox[{
    StyleBox["p_Integer", "TI"], ",", 
    StyleBox["M_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b34e3f48-a194-49db-9931-0782946dc634"],
 "\ngives the same count summed over the vertex count ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "afd5c947-28c8-407f-8347-83b21dae2449"],
 "."
}], "Usage",
 CellChangeTimes->{{3.970835558127205*^9, 3.970835596963972*^9}},
 CellID->286026054,ExpressionUUID->"7c2aeedd-6e29-4e5c-a09e-617bce45a3fc"],

Cell[TextData[{
 "The count is zero unless ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "9f49886f-0730-4bc6-9821-f57c9c73b0df"],
 " \[LessEqual] ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "88c6226c-d7e0-4fcb-81bd-ea87c7154877"],
 " \[LessEqual] ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "1ee9d145-6ef0-4359-bcc9-1c52ccbffc26"],
 " ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "84381e14-623e-4cfc-9e5a-d8832c467a56"],
 ": fewer than ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "e749a8e5-d82a-483e-8eb2-a4b55136c405"],
 " vertices cannot carry a facet, and ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "d2ca04d5-17c0-4cbd-94b5-ddf9bc8747bb"],
 " facets of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "39be7d89-f51f-42d0-84ef-d2c41c44ed0d"],
 " vertices cannot cover more than ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "93978f43-3bbb-4661-b84a-a6759d617766"],
 " ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "ffc3c425-feb3-40e9-9a6f-424d49858e50"],
 " of them."
}], "Notes",
 CellID->243188428,ExpressionUUID->"aa80a828-7cf3-420d-83cd-650caf191958"]
}, Open  ]],

