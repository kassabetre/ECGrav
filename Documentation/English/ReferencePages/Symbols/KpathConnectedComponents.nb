Notebook[{

Cell[CellGroupData[{
Cell["KpathConnectedComponents", "ObjectName",
 CellID->50461007,ExpressionUUID->"d34eb87b-e892-6b40-b738-22badf3b5368"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"66941aab-e760-7343-adf1-baf60c8dbe4c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["KpathConnectedComponents",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/KpathConnectedComponents"], "[", 
   RowBox[{
    StyleBox["facetsLst_List", "TI"], ",", 
    StyleBox["k_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ca59b92f-7604-da4f-a011-5bdb2cdfca6f"],
 "\[LineSeparator]Given a complex as a list of facets ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "ef6588ec-0315-fd4f-9ae5-e41396880e43"],
 " and dimensionality ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "4e4bda09-960c-1440-89da-ac9095bcbaae"],
 ", it computes the number of components connected by (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "41ca2b97-ad59-0945-93e8-6799b08036bb"],
 "+1)-paths where those ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "5ad970de-fbc3-504f-a121-85a121124068"],
 "-faces that form a component connected by a path of (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "deafcb15-416b-0847-82ae-a3fadfc0c8d5"],
 "+1)-dimensional faces will form a component. It uses the built in \
Mathematica KVertexConnectedComponents function on a graph constructed such \
that the vertices are all ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "a516590a-815a-8245-9877-91f72d6e8977"],
 "-faces and edges between them are 1 if two faces are contained in a bigger \
clique and 0 otherwise.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d59e7bfa-c05c-a445-911a-455025f9555c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["KpathConnectedComponents",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/KpathConnectedComponents"], "[", 
   RowBox[{
    StyleBox["g_Graph", "TI"], ",", 
    StyleBox["k_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c4bb8640-e822-004d-864c-1d2676b18cff"],
 "\[LineSeparator]Given a complex as a graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "e93df0e4-1ba8-d04f-8f0f-7d54cfee48bd"],
 " and dimensionality ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "ca897a62-9710-8c46-9a65-91b54cc86b1a"],
 ", it computes the number of components connected by (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "6db74b4f-9eeb-2849-81cf-7d972afe828f"],
 "+1)-paths where those k-faces that form a component connected by a path of \
(",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "05b5c3c7-b938-c046-bb90-8fdbff3f7900"],
 "+1)-dimensional faces will form a component. It uses the built in \
Mathematica KVertexConnectedComponents function on a graph constructed such \
that the vertices are all ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "d0be8bd9-56c4-594c-8d42-62a78002165c"],
 "-faces and edges between them are 1 if two faces are contained in a bigger \
clique and 0 otherwise."
}], "Usage",
 CellChangeTimes->{{3.9719011002836857`*^9, 3.9719011003477516`*^9}, {
  3.9719011607244987`*^9, 3.971901190897991*^9}, {3.971912465089468*^9, 
