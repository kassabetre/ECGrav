Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2afac871-5230-aa4a-8d68-95b80f234db7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UnrankComb",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/UnrankComb"], "[", 
   RowBox[{
    StyleBox["l_Integer", "TI"], ",", 
    StyleBox["numLabels_Integer", "TI"], ",", 
    StyleBox["setSize_Integer", "TI"]}], "]"}]], "InlineFormula",
  ExpressionUUID->"09c449bc-9c05-4a49-a3a3-774c186ca6a8"],
 "\[LineSeparator]Given an integer ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "40b9588d-8e9f-574d-afc1-b5182cf8e669"],
 " between 0 and ",
 Cell[BoxData[
  StyleBox["numLabels", "TI"]], "InlineFormula",ExpressionUUID->
  "aebc8c4b-9bd7-ae4c-b257-605a58de4f7f"],
 " choose ",
 Cell[BoxData[
  StyleBox["setSize", "TI"]], "InlineFormula",ExpressionUUID->
  "2a5ac8e9-83cf-8b44-83a7-84c4e36f067c"],
 "-1,it assigns a unique sorted set which is a ",
 Cell[BoxData[
  StyleBox["setSize", "TI"]], "InlineFormula",ExpressionUUID->
  "1d4ea051-f8e8-da44-a469-011d4a39fb7f"],
 "-subset of {0,1,,...,",
 Cell[BoxData[
  StyleBox["numLabels", "TI"]], "InlineFormula",ExpressionUUID->
  "b3aff661-e52f-0b4a-b2e2-5746bbfde117"],
 "-1}.\[IndentingNewLine]E.g., UnrankComb[0, 3, 2] = {0,1}, and UnrankComb[2, \
3, 2] = {1,2}."
}], "Usage",
 CellChangeTimes->{{3.97083328802071*^9, 3.9708333213420753`*^9}, {
