Cell[CellGroupData[{
Cell["SpecificHeat", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2a69e64f-e341-4fe4-a61a-97ccec1871cc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SpecificHeat",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/SpecificHeat"], "[", 
   StyleBox[
    RowBox[{"energyTable_List", ",", " ", "NN_Integer", ",", " ", "beta_"}], 
    "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "392486ba-820a-4b98-930c-b532eb98e15e"],
 " gives the specific heat per site from the energy measurements ",
 Cell[BoxData[
  StyleBox["energyTable", "TI"]], "InlineFormula",ExpressionUUID->
  "036b2270-4251-4994-b473-edb3f9ee153b"],
 " for ",
 Cell[BoxData[
  StyleBox["NN", "TI"]], "InlineFormula",ExpressionUUID->
  "ade3d465-a4e2-41ae-8dc9-10c2757a7431"],
 " sites at inverse temperature ",
 Cell[BoxData[
  StyleBox["beta", "TI"]], "InlineFormula",ExpressionUUID->
  "44eb5b97-249d-42c3-bbc8-ba11ca40a3b8"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Computed from the variance of the energy: C = beta^2 (\[LeftAngleBracket]E^2\
\[RightAngleBracket] - \[LeftAngleBracket]E\[RightAngleBracket]^2)/NN. \
DSpecificHeat gives its temperature derivative.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

