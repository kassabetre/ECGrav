Notebook[{

Cell[CellGroupData[{
Cell["RandomUniformUnlabeledPureSimplicialComplex", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"badaee4b-e847-4156-97df-75d932737d4b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomUniformUnlabeledPureSimplicialComplex",
    BaseStyle->"Link",
    ButtonData->
     "paclet:ECGrav/ref/RandomUniformUnlabeledPureSimplicialComplex"], "[", 
   StyleBox[
    RowBox[{"{", 
     RowBox[{"p_Integer", ",", "q_Integer"}], "}"}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"9c8844c1-7456-4c2a-b1ba-b8d85165807e"],
 " generates a uniformly random unlabeled pure simplicial complex of purity \
",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "31e496e1-42ea-416e-b0dd-926c0bc38abc"],
 " and facet-order ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",ExpressionUUID->
  "d693ea19-090e-4607-9221-7c37b1e907d5"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"25958c74-6208-4ff1-ae06-30be3c8aa9a1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomUniformUnlabeledPureSimplicialComplex",
    BaseStyle->"Link",
    ButtonData->
     "paclet:ECGrav/ref/RandomUniformUnlabeledPureSimplicialComplex"], "[", 
   StyleBox[
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p_Integer", ",", "q_Integer"}], "}"}], ",", " ", 
     "numSamples_Integer"}], "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "09e83884-cfe3-42b5-ae88-ac5bad94af51"],
 " returns a list of ",
 Cell[BoxData[
  StyleBox["numSamples", "TI"]], "InlineFormula",ExpressionUUID->
  "f7e07661-b65a-47db-9cde-1230b5c23216"],
 " such complexes; an optional vertex count ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "e3c9f1a1-94f1-41f4-9dbc-e2d878fde5a9"],
 " may be given as a third element of the first argument."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
Sampling is uniform over unlabeled complexes (isomorphism classes). Results \
are random; seed with SeedRandom for reproducibility.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

