Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"51582447-981c-8342-b520-58c49b361be8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FractionInLargestKPathComponent",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/FractionInLargestKPathComponent"], "[", 
