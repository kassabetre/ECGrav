    StyleBox["g_Graph", "TI"], ",", 
    StyleBox["k_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fcabcdb4-8d0c-414b-9fc2-c06c3f212148"],
 "\[LineSeparator]Given a graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "96e913e0-5d95-7147-bcac-5e68be7c0b0d"],
 " and dimension ",
