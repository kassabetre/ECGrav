Cell["\<\
Starting from the octahedron, adding the edge between the two opposite \
vertices 1 and 6 raises the 2D-manifold energy by 27:\
\>", "ExampleText",
 CellID->714309228,ExpressionUUID->"7de712e4-83b0-40d0-98fb-2520ec8fba05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"delH2dCombManifold", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"AdjacencyMatrix", "[", 
     RowBox[{"GraphFromCliques", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "3", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "4", ",", "5"}], "}"}]}], "}"}], "]"}], "]"}], 
    "]"}], ",", "1.`", ",", "1", ",", "6"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->253906639,ExpressionUUID->"7407d2a1-08c8-4852-bf09-9a31f625947d"],

Cell[BoxData["27.`"], "Output",
 CellLabel->"Out[1]=",
 CellID->962046740,ExpressionUUID->"4536a96b-6aa8-4266-a5e4-d9f1a8eb87b1"]
}, Open  ]]
}, Open  ]],

