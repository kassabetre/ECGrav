Cell[CellGroupData[{
Cell["FacetLabeledVertexListFromComplex", "ObjectName",
 CellChangeTimes->{{3.9707780844505672`*^9, 3.9707780847939644`*^9}},
 CellID->776569711,ExpressionUUID->"db0cd54a-f720-7a4f-b0b2-2d794810d9cf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"91bad8e0-208a-3240-82a9-d475876c374e"],
 Cell[BoxData[
  ButtonBox["FacetLabeledVertexListFromComplex",
   BaseStyle->"Link",
   ButtonData->"paclet:ECGrav/ref/GetFacetLabeledVertexListFromComplex"]], 
  "InlineFormula",ExpressionUUID->"36bbaf43-d80f-b04b-9fa7-aa17e9f65b91"],
 "[",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "1a9f7b66-f502-6546-a210-2b7c0dc96d30"],
 "]\[LineSeparator]Given a complex as a list of facets, it returns it as a \
list of vertices of the complex labeled by the facets they belong to by order \
of descending cardinality, then canonically element-wise (i.e., a \
facet-labeled complex)."
}], "Usage",
 CellChangeTimes->{{3.970777336755192*^9, 3.970777480086216*^9}, {
  3.9707775107357025`*^9, 3.9707775297226124`*^9}, {3.970777583658186*^9, 
