Cell["A vertex labeled graph, g:", "ExampleText",
 CellChangeTimes->{3.9707776124694023`*^9},
 CellID->83853978,ExpressionUUID->"b9beb27f-a010-9e40-9601-ba71f645f88d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "\[UndirectedEdge]", "2"}], ",", 
      RowBox[{"2", "\[UndirectedEdge]", "3"}], ",", 
      RowBox[{"3", "\[UndirectedEdge]", "4"}], ",", 
      RowBox[{"1", "\[UndirectedEdge]", "3"}]}], "}"}], ",", 
    RowBox[{"VertexLabels", "\[Rule]", "\"\<Name\>\""}], ",", 
    RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}]], "Input",
 CellLabel->"In[99]:=",
 CellID->40159814,ExpressionUUID->"5beb0e5e-a90b-9148-95f5-0672cf00e370"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, {{1, 2}, {2, 3}, {3, 4}, {1, 3}}}, {
      ImageSize -> Medium, VertexLabels -> {"Name"}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[0.], 
        ArrowBox[{{{0.0001964751172666146, 0.}, {0., 0.8475386976306538}}, {{
         0.0001964751172666146, 0.}, {0.9164048379140673, 
         0.42386488156829044`}}, {{0., 0.8475386976306538}, {
         0.9164048379140673, 0.42386488156829044`}}, {{0.9164048379140673, 
         0.42386488156829044`}, {2.031430211699506, 0.42382043094346533`}}}, 
         0.022865977658369868`]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[
        0.7]}], {DiskBox[{0.0001964751172666146, 0.}, 0.022865977658369868], 
         InsetBox["1", 
          Offset[{2, 2}, {0.023062452775636483, 0.022865977658369868}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{0., 0.8475386976306538}, 0.022865977658369868], 
         InsetBox["2", 
          Offset[{2, 2}, {0.022865977658369868, 0.8704046752890237}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{0.9164048379140673, 0.42386488156829044`}, 
          0.022865977658369868], 
         InsetBox["3", 
          Offset[{2, 2}, {0.9392708155724372, 0.44673085922666034}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{2.031430211699506, 0.42382043094346533`}, 
          0.022865977658369868], 
         InsetBox["4", 
          Offset[{2, 2}, {2.054296189357876, 0.44668640860183517}], 
          ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None,
  ImageSize->Medium]], "Output",
 CellChangeTimes->{3.97077762273942*^9, 3.9707777923032856`*^9, 
