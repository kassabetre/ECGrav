Cell["\<\
The octahedron, given by its triangular facets, is a clique complex:\
\>", "ExampleText",
 CellID->412195755,ExpressionUUID->"572a9b12-8ae0-4260-bdaa-1c745f10282a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CliqueComplexQ", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "2", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "3", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "4", ",", "5"}], "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->751916524,ExpressionUUID->"9e4c2ecb-745e-4094-8423-40f0ed74814c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->761991964,ExpressionUUID->"83912ccb-b263-4982-8d26-939857170a0b"]
}, Open  ]],

Cell["\<\
The bare boundary of a triangle is not \[LongDash] its three mutually \
adjacent vertices form a clique whose 2-face is missing:\
\>", "ExampleText",
 CellID->960454865,ExpressionUUID->"57aad3dc-d496-49ea-a1f3-70d240bbdf88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CliqueComplexQ", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->530196477,ExpressionUUID->"fc7409c2-e161-4f42-94d1-0523ae7b4ef5"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[2]=",
 CellID->919718441,ExpressionUUID->"f7a48962-8bee-46e4-bd55-953b2dfad64e"]
}, Open  ]]
}, Open  ]],

