Notebook[{

Cell[CellGroupData[{
Cell["CliqueComplexQ", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d29715d0-c65f-410a-a1a9-0f3b0139caaf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CliqueComplexQ",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/CliqueComplexQ"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "cb605f11-7a2e-4735-bd10-43b971eb4c39"],
 " gives True if the complex given as a list of facets ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "107f8765-7886-4a36-9d0e-3e7e037a80ad"],
 " is a clique (flag) complex, and False otherwise."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
A clique complex is determined by its 1-skeleton: every clique of the \
underlying graph is filled in as a face. GraphFromCliques builds a complex of \
this kind from a graph.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

