Notebook[{

Cell[CellGroupData[{
Cell["FVector", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3d223dab-5a16-4674-8c74-cb5e4ea702d1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FVector",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/FVector"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b12231e7-1288-43d3-9141-30f1d81b5adf"],
 " gives the f-vector {f0, f1, \[Ellipsis]} \[LongDash] the numbers of \
vertices, edges, triangular faces, and so on \[LongDash] of the simplicial \
complex given as a list of facets ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "79680875-2d05-471a-ab66-7e261f1643b9"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0959f32d-e32e-4355-b9b9-63634830eba7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FVector",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/FVector"], "[", 
   StyleBox["g_Graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "76a9836f-99fc-47e5-a674-30a666cfc40c"],
 " gives the f-vector of the clique complex of the graph ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "1b182487-cb03-435a-aee0-4e2d7bb4504a"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4b2a0b34-1502-4426-801d-50fdda321d6b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FVector",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/FVector"], "[", 
   StyleBox["Amat_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ce9a1324-9f14-4505-af1e-4ce8df94bb9f"],
 " gives the f-vector of the clique complex of the graph with adjacency \
matrix ",
 Cell[BoxData[
  StyleBox["Amat", "TI"]], "InlineFormula",ExpressionUUID->
  "bcea16b7-f02d-4661-8a10-a3051557aeb0"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The f-vector has one entry per face dimension, so its length is one more than \
the dimension of the complex. Its alternating sum f0 - f1 + f2 - \[Ellipsis] \
is the Euler characteristic (see EulerChi).\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

