Cell["\<\
Take the octahedron, given as its list of eight triangular facets:\
\>", "ExampleText",
 CellID->469918665,ExpressionUUID->"888d9cdb-cd03-4120-b2de-672b6510c665"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"octahedron", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "2", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "3", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "4", ",", "5"}], "}"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->160669067,ExpressionUUID->"18eb4f3d-69ed-4429-bff8-e2d372455b4e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "3", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "4", ",", "5"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->805294649,ExpressionUUID->"96684243-a7fd-490c-864c-fd62060398be"]
}, Open  ]],

Cell["\<\
Its f-vector records 6 vertices, 12 edges, and 8 triangular faces:\
\>", "ExampleText",
 CellID->690162140,ExpressionUUID->"43d2de17-89c4-4831-baaf-45a78da185f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FVector", "[", "octahedron", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->107826438,ExpressionUUID->"e3bbfc4b-51ca-45f2-af44-3e64687ab50d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "12", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->299795674,ExpressionUUID->"193600fa-12f2-4a36-9612-2c19b52d2cfe"]
}, Open  ]],

Cell["The same complex passed as a graph gives the same f-vector:", \
"ExampleText",
 CellID->116105674,ExpressionUUID->"740634cc-9e0a-41fc-b0d6-d4c90416d9cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FVector", "[", 
  RowBox[{"GraphFromCliques", "[", "octahedron", "]"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->685490273,ExpressionUUID->"80f434b5-ad9d-4703-9f30-4eb182e1ae32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "12", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->538330874,ExpressionUUID->"6edada67-9693-4743-81ea-35b9dadde29e"]
}, Open  ]],

Cell["\[Ellipsis] as does its graph adjacency matrix:", "ExampleText",
 CellID->135529992,ExpressionUUID->"47aa9e36-af13-48f4-80af-2748b6eb4d1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FVector", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"AdjacencyMatrix", "[", 
    RowBox[{"GraphFromCliques", "[", "octahedron", "]"}], "]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->312389347,ExpressionUUID->"5c3939b6-5e52-4cc0-8a44-c9137853a065"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "12", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->402020693,ExpressionUUID->"082d531b-0e43-4b1c-98af-77a9823f519a"]
}, Open  ]]
}, Open  ]],

