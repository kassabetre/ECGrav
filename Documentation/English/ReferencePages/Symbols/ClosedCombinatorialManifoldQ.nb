Cell["\<\
The octahedron is a closed surface, hence a closed combinatorial manifold:\
\>", "ExampleText",
 CellID->585534659,ExpressionUUID->"45db5561-7620-4abf-8813-a22a93e402be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ClosedCombinatorialManifoldQ", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "2", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "3", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"6", ",", "4", ",", "5"}], "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->726601063,ExpressionUUID->"d723dab6-67f2-4b8a-a5b2-ca2e1b9476ab"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->775878486,ExpressionUUID->"33d8da3e-2277-4139-92db-9572a46e390f"]
}, Open  ]],

Cell["\<\
Two triangles joined only at a vertex have free edges, so the complex has \
boundary and is not closed:\
\>", "ExampleText",
 CellID->159323869,ExpressionUUID->"00048cef-5e66-4e29-9383-13802da2b295"],

