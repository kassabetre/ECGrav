Cell[CellGroupData[{
Cell["CvOverT", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d3fab0c0-a6bc-497a-bb20-5f7fed515507"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CvOverT",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/CvOverT"], "[", 
   StyleBox[
    RowBox[{
    "bf_", ",", " ", "minusBetaF_Association", ",", " ", 
     "energyMeasurements_Association"}], "TI"], "]"}]], "InlineFormula",
  ExpressionUUID->"47234ee0-03de-48df-ad8f-f93ba98eb93a"],
 " computes the specific heat divided by temperature (Cv/T, not per site) at \
inverse temperature ",
 Cell[BoxData[
  StyleBox["bf", "TI"]], "InlineFormula",ExpressionUUID->
  "6507a4b0-789f-4129-a8b3-88e75f74605e"],
 " from the multi-histogram data ",
 Cell[BoxData[
  StyleBox["minusBetaF", "TI"]], "InlineFormula",ExpressionUUID->
  "c24d5555-80df-4c4f-a811-8db4df366b68"],
 " and ",
 Cell[BoxData[
  StyleBox["energyMeasurements", "TI"]], "InlineFormula",ExpressionUUID->
  "ef54b49d-a658-4ba6-aaa2-9be9795aa15a"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
A multi-histogram reweighting quantity, built from the energy fluctuations \
across the combined runs. The two associations must share the same beta keys \
with equal-length measurement lists.\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

