Notebook[{

Cell[CellGroupData[{
Cell["CombinatorialBoundary", "ObjectName",
 CellID->572683887,ExpressionUUID->"c4f02fc7-48ca-3c41-b361-e48cdf599268"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5b09f597-d548-4f31-bde5-ff455584ed92"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CombinatorialBoundary",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/CombinatorialBoundary"], "[", 
   StyleBox["facetsLst_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9654521b-0d66-402a-b7c0-a4186ad6a552"],
 " returns the boundary of the complex ",
 Cell[BoxData[
  StyleBox["facetsLst", "TI"]], "InlineFormula",ExpressionUUID->
  "d61efc6e-7f7d-45de-a2e2-288b6398f208"],
 ", assumed to be a combinatorial manifold \[LongDash] the codimension-1 \
faces that lie in exactly one facet."
}], "Usage",
 CellChangeTimes->{{3.9719700761249638`*^9, 3.9719701983964806`*^9}},
 CellID->340984395,ExpressionUUID->"552cb548-8c9b-bd4c-8c0b-d80619e7b9f7"],

Cell["\<\
The boundary of a closed manifold is empty. CombinatorialBoundary assumes its \
input is a combinatorial manifold (see CombinatorialManifoldQ).\
\>", "Notes",
 CellID->822687678,ExpressionUUID->"bffffc96-8aca-2043-be7e-15e0ca3df4df"]
}, Open  ]],

