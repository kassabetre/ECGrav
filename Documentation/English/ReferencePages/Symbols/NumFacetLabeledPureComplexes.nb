Notebook[{

Cell[CellGroupData[{
Cell["NumFacetLabeledPureComplexes", "ObjectName",
 CellID->998808613,ExpressionUUID->"a837dc15-4e41-4f70-95ff-8bea3aed4bf8"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["NumFacetLabeledPureComplexes",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NumFacetLabeledPureComplexes"], "[", 
   RowBox[{
    StyleBox["p_Integer", "TI"], ",", 
    StyleBox["M_Integer", "TI"], ",", 
    StyleBox["n_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "172cd553-4172-452b-94c7-bf9d6d9d7c53"],
 "\ngives the number of facet labeled pure simplicial complexes of purity ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "51fbdf6b-64b4-41d8-8040-3f46a11201cc"],
 ", facet order ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "11aa101a-c570-432d-b90d-cc6af78b910c"],
 ", and number of vertices ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "f414d55b-0eac-4d0b-8238-bf97ac6a84de"],
 ": ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "22245246-c25b-4f9d-b0d7-013726655519"],
 " labeled, pairwise distinct ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "9c73c0e1-6903-4997-b2df-ed6730d894cb"],
 "-subsets of an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "3e11a516-a0c6-4008-a675-c1698c2abde1"],
 "-element vertex set whose union is the whole set, counted up to permutation \
of the vertices, which are not labeled.\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NumFacetLabeledPureComplexes",
    BaseStyle->"Link",
    ButtonData->"paclet:ECGrav/ref/NumFacetLabeledPureComplexes"], "[", 
   RowBox[{
    StyleBox["p_Integer", "TI"], ",", 
    StyleBox["M_Integer", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "56fb0683-8ab5-4dd0-994a-493fa0d29fad"],
 "\ngives the same count summed over the vertex count ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "37b215fc-9efb-4d7c-9f23-e2ba37cde3c5"],
 "."
}], "Usage",
 CellChangeTimes->{{3.970835558127205*^9, 3.970835596963972*^9}},
 CellID->398463871,ExpressionUUID->"4738402b-1fb2-4ad0-b3a9-cdcba77c5395"],

Cell[TextData[{
 "Equivalently the number of separating (",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "141f2240-481a-4690-b87c-c035f8acf41b"],
 ", ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "af9f3989-a4d4-4ead-8058-2cd6155f14c7"],
 ", ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "6fb6c6a1-572b-40e9-87e2-59d191ef1ab2"],
 ") incidence tableaux: multisets of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "22c58da6-6166-4911-bc07-6ca1a762d37b"],
 " nonempty subsets of ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "fa3877fd-d530-4533-b510-bb52c51262a7"],
 " labels in which every label occurs in exactly ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "99d3b8d0-0359-424c-bd9e-c53de3b3d653"],
 " of them and no two labels occupy the same set of rows. The count is zero \
unless ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "13b03830-c72b-4567-9c0c-2dbd866a5d19"],
 " \[LessEqual] ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "a1e9993a-7e1e-4993-b1f3-d4fc990b2586"],
 " \[LessEqual] ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "926e3926-cd22-4e3d-8efd-c971cb0541d7"],
 " ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "7d5ddc1b-3135-43cc-8eab-648519e2e06c"],
 ", and zero when there are fewer than ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "ac905ff2-3ce5-4b35-923a-4950761b0c85"],
 " distinct ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "7cb97641-ea6a-4f9b-a815-2c1c1c543e0e"],
 "-subsets to draw the facets from."
}], "Notes",
 CellID->406713778,ExpressionUUID->"58ebf0c5-6f5a-4e7e-8690-e88e125468f9"]
}, Open  ]],

